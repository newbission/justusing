---
/**
 * 모든 도구 페이지를 만드는 라우트. 레지스트리의 live 도구마다 /<카테고리>/<이름>/ 페이지를 하나씩 만든다.
 *
 * 도구 화면은 격리 iframe(/<카테고리>/<이름>/frame/)으로 띄우고,
 * 그 아래 사용법·FAQ·관련 가이드·관련 도구는 content.ts·meta.ts·가이드 글에서 그린다.
 */
import type { GetStaticPaths } from 'astro';
import { toolPaths } from '../../tools/paths';
import ToolLayout from '../../layouts/ToolLayout.astro';
import ToolFrame from '../../components/ToolFrame.astro';
import ToolHowTo from '../../components/ToolHowTo.astro';
import ToolFaq from '../../components/ToolFaq.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import ToolGuides from '../../components/ToolGuides.astro';
import { CATEGORIES } from '../../tools/categories';
import { COMMON_FAQ } from '../../tools/common-faq';
import { toolsInCategory, type Tool } from '../../tools/registry';
import { localeOf, localizePath } from '../../i18n/locales';
import { ui } from '../../i18n/ui';

export const getStaticPaths = toolPaths satisfies GetStaticPaths;

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const locale = localeOf(Astro.url.pathname);
const t = ui(locale);
const text = tool.text[locale];
// live 도구는 레지스트리가 content.ts를 보장한다
const content = tool.content![locale];
const href = localizePath(tool.href, locale);
const breadcrumb = [
  { name: t.nav.home, href: localizePath('/', locale) },
  {
    name: CATEGORIES[tool.category].text[locale].name,
    href: localizePath(`/${tool.category}/`, locale),
  },
  { name: text.name },
];
// 브레드크럼에서 같은 분류의 다른 도구로 넘어가기 (준비 중인 도구는 링크 없이)
const siblings = toolsInCategory(tool.category).map((other) => ({
  name: other.text[locale].name,
  href: other.status === 'live' ? localizePath(other.href, locale) : undefined,
  current: other.id === tool.id,
}));
---

<ToolLayout
  name={text.name}
  title={text.title}
  description={text.description}
  breadcrumb={breadcrumb}
  {siblings}
>
  <ToolFrame slot="tool" src={`${href}frame/`} title={t.tool.frameTitle(text.name)} />
  <ToolHowTo slot="how-to" name={text.name} steps={content.howTo} />
  <ToolFaq slot="faq" items={[...COMMON_FAQ[locale], ...content.faq]} />
  <Fragment slot="related">
    <ToolGuides toolId={tool.id} />
    <RelatedTools ids={tool.related ?? []} />
  </Fragment>
</ToolLayout>
