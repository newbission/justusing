---
/**
 * 모든 도구 페이지를 만드는 라우트. 레지스트리의 live 도구마다 /<카테고리>/<이름>/ 페이지를 하나씩 만든다.
 *
 * 도구 화면은 격리 iframe(/<카테고리>/<이름>/frame/)으로 띄우고,
 * 그 아래 사용법·FAQ·관련 도구는 content.ts와 meta.ts에서 그린다.
 */
import type { GetStaticPaths } from 'astro';
import ToolLayout from '../../layouts/ToolLayout.astro';
import ToolFrame from '../../components/ToolFrame.astro';
import ToolHowTo from '../../components/ToolHowTo.astro';
import ToolFaq from '../../components/ToolFaq.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { CATEGORIES } from '../../tools/categories';
import { liveTools, type Tool } from '../../tools/registry';

export const getStaticPaths = (() =>
  liveTools.map((tool) => {
    const [category, slug] = tool.id.split('/');
    return { params: { category, tool: slug }, props: { tool } };
  })) satisfies GetStaticPaths;

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const text = tool.text.ko;
// live 도구는 레지스트리가 content.ts를 보장한다
const content = tool.content!.ko;
const breadcrumb = [
  { name: '홈', href: '/' },
  { name: CATEGORIES[tool.category].text.ko.name, href: `/${tool.category}/` },
  { name: text.name },
];
---

<ToolLayout
  name={text.name}
  title={text.title}
  description={text.description}
  breadcrumb={breadcrumb}
>
  <ToolFrame slot="tool" src={`${tool.href}frame/`} title={`${text.name} 도구 화면`} />
  <ToolHowTo slot="how-to" name={text.name} steps={content.howTo} />
  <ToolFaq slot="faq" items={content.faq} />
  <RelatedTools slot="related" ids={tool.related ?? []} />
</ToolLayout>
