---
/**
 * 카테고리 페이지 (/pdf/ 등). 도구가 있는 카테고리마다 하나씩 만든다.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolGrid from '../../components/ToolGrid.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RailShell from '../../components/RailShell.astro';
import AdSlot from '../../components/AdSlot.astro';
import { CATEGORIES, type CategoryId } from '../../tools/categories';
import { toolsInCategory } from '../../tools/registry';
import { categoryPaths } from '../../tools/paths';
import { localeOf, localizePath } from '../../i18n/locales';
import { ui } from '../../i18n/ui';

export const getStaticPaths = categoryPaths satisfies GetStaticPaths;

interface Props {
  category: CategoryId;
}

const { category } = Astro.props;
const locale = localeOf(Astro.url.pathname);
const t = ui(locale);
const text = CATEGORIES[category].text[locale];
const title = t.category.title(text.name);
---

<BaseLayout title={title} description={text.description}>
  <RailShell>
    <div class="category-page">
      <Breadcrumb
        items={[{ name: t.nav.home, href: localizePath('/', locale) }, { name: text.name }]}
      />
      <h1>{title}</h1>
      <p class="lead">{text.description}</p>
      <!-- 제목 아래 가로 배너 -->
      <div class="top-banner">
        <AdSlot id="top-banner" />
      </div>
      <ToolGrid tools={toolsInCategory(category)} headingLevel={2} />

      <!-- 도구 목록 아래 본문 광고 (홈과 같은 이유로 목록 아래, 48px 띄움) -->
      <div class="in-content">
        <AdSlot id="in-content" />
      </div>
    </div>
  </RailShell>
</BaseLayout>

<style>
  .category-page {
    padding-top: 24px;
  }
  h1 {
    margin: 12px 0 0;
    font-size: 28px;
    line-height: 1.3;
  }
  .lead {
    margin: 8px 0 24px;
    color: var(--color-muted);
  }
  /* 제목 아래 가로 배너. 광고 칸이 없으면 자리도 차지하지 않는다 */
  .top-banner:not(:has(.ad-slot)) {
    display: none;
  }
  .top-banner {
    margin-bottom: 32px;
  }
  .in-content {
    margin: 48px 0;
  }
</style>
