---
/**
 * 카테고리 페이지 (/pdf/ 등). 도구가 있는 카테고리마다 하나씩 만든다.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolSections from '../../components/ToolSections.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RailShell from '../../components/RailShell.astro';
import AdSlot from '../../components/AdSlot.astro';
import { CATEGORIES, type CategoryId } from '../../tools/categories';
import { categoryPaths } from '../../tools/paths';
import { localeOf, localizePath } from '../../i18n/locales';
import { ui } from '../../i18n/ui';
import { guidesIn, slugOf } from '../../guides';

export const getStaticPaths = categoryPaths satisfies GetStaticPaths;

interface Props {
  category: CategoryId;
}

const { category } = Astro.props;
const locale = localeOf(Astro.url.pathname);
const t = ui(locale);
const text = CATEGORIES[category].text[locale];
const title = t.category.title(text.name);
// 이 카테고리 도구를 안내하는 가이드 (도구 목록 아래 링크로 단다)
const guides = guidesIn(locale).filter((guide) => guide.data.tool.startsWith(`${category}/`));
---

<BaseLayout title={text.title} description={text.description}>
  <RailShell>
    <div class="category-page">
      <Breadcrumb
        items={[{ name: t.nav.home, href: localizePath('/', locale) }, { name: text.name }]}
      />
      <h1>{title}</h1>
      <p class="lead">{text.description}</p>
      <!-- 제목 아래 가로 배너 -->
      <div class="top-banner">
        <AdSlot id="top-banner" />
      </div>
      <ToolSections {category} headingLevel={2} />

      {guides.length > 0 && (
        <section class="guides">
          <h2>{t.guide.forCategory(text.name)}</h2>
          <ul>
            {guides.map((guide) => (
              <li>
                <a href={localizePath(`/guide/${slugOf(guide)}/`, locale)}>{guide.data.title}</a>
                <p>{guide.data.description}</p>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- 도구 목록 아래 본문 광고 (홈과 같은 이유로 목록 아래, 48px 띄움) -->
      <div class="in-content">
        <AdSlot id="in-content" />
      </div>
    </div>
  </RailShell>
</BaseLayout>

<style>
  .category-page {
    padding-top: 24px;
  }
  h1 {
    margin: 12px 0 0;
    font-size: 28px;
    line-height: 1.3;
  }
  .lead {
    margin: 8px 0 24px;
    color: var(--color-muted);
  }
  /* 제목 아래 가로 배너. 광고 칸이 없으면 자리도 차지하지 않는다 */
  .top-banner:not(:has(.ad-slot)) {
    display: none;
  }
  .top-banner {
    margin-bottom: 32px;
  }
  .in-content {
    margin: 48px 0;
  }
  .guides {
    margin-top: 48px;
  }
  .guides h2 {
    margin: 0 0 16px;
    font-size: 22px;
  }
  .guides ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .guides li {
    margin-bottom: 16px;
  }
  .guides a {
    color: var(--color-accent);
    font-weight: 600;
  }
  .guides p {
    margin: 4px 0 0;
    color: var(--color-muted);
    font-size: 14px;
  }
</style>
