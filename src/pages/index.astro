---
/**
 * 허브: 전체 도구 목록. 카테고리와 도구는 레지스트리에서 자동으로 채운다.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolGrid from '../components/ToolGrid.astro';
import RailShell from '../components/RailShell.astro';
import AdSlot from '../components/AdSlot.astro';
import Promises from '../components/Promises.astro';
import SafetyDiagram from '../components/SafetyDiagram.astro';
import { siteConfig } from '../site.config';
import { localeOf } from '../i18n/locales';
import { CATEGORIES } from '../tools/categories';
import { toolsInCategory, visibleCategories } from '../tools/registry';

const locale = localeOf(Astro.url.pathname);
const text = siteConfig.text[locale];

// 검색 결과에 사이트 이름이 제대로 나오게 하는 구조화 데이터 (schema.org WebSite)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: Astro.site?.href,
  description: text.description,
  inLanguage: locale,
};
---

<BaseLayout>
  <!-- 틀 안에 둔다. 틀 밖에 두면 <html>보다 먼저 출력된다 -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <RailShell>
    <section class="hero">
      <h1>{text.tagline}</h1>
      <p class="lead">{text.description}</p>
    </section>

    <!-- 제목 아래 가로 배너 -->
    <div class="top-banner">
      <AdSlot id="top-banner" />
    </div>

    <!-- 이 사이트의 약속: 배너 아래에 크게 -->
    <section class="promises-section">
      <Promises />
    </section>

    <!-- 약속을 그림으로: 왜 안전한지 한눈에 -->
    <div class="safety-section">
      <SafetyDiagram />
    </div>

    {visibleCategories.map((category) => (
      <section class="category">
        <h2>
          <a href={`/${category}/`}>{CATEGORIES[category].text.ko.name} 도구</a>
        </h2>
        <ToolGrid tools={toolsInCategory(category)} headingLevel={3} />
      </section>
    ))}

    <!-- 도구 목록 아래 본문 광고. 목록 위에 두면 첫 화면에서 도구가 밀려나므로 아래에 둔다 -->
    <div class="in-content">
      <AdSlot id="in-content" />
    </div>
  </RailShell>
</BaseLayout>

<style>
  .hero {
    padding: 48px 0 32px;
  }
  h1 {
    margin: 0;
    font-size: clamp(26px, 5vw, 36px);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .lead {
    margin: 12px 0 0;
    color: var(--color-muted);
  }
  .promises-section {
    margin-bottom: 40px;
  }
  .safety-section {
    margin-bottom: 40px;
  }
  .category {
    margin-top: 16px;
  }
  .category h2 {
    margin: 0 0 16px;
    font-size: 20px;
  }
  .category h2 a {
    text-decoration: none;
  }
  .category h2 a:hover {
    text-decoration: underline;
  }
  /* 제목 아래 가로 배너. 광고 칸이 없으면 자리도 차지하지 않는다 */
  .top-banner:not(:has(.ad-slot)) {
    display: none;
  }
  .top-banner {
    margin-bottom: 32px;
  }
  /* 도구 카드와 헷갈려 누르지 않게 충분히 띄운다 */
  .in-content {
    margin: 48px 0;
  }
</style>
