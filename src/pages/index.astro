---
/** 홈: 바로 쓰는 도구와 실제 처리 결과. 견본 사진은 직접 호스팅한다. */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolSections from '../components/ToolSections.astro';
import HomeShowcase from '../components/HomeShowcase.astro';
import HomeValueStory from '../components/HomeValueStory.astro';
import HomeLocalFlow from '../components/HomeLocalFlow.astro';
import RailShell from '../components/RailShell.astro';
import AdSlot from '../components/AdSlot.astro';
import { siteConfig } from '../site.config';
import { localeOf, localizePath } from '../i18n/locales';
import { ui } from '../i18n/ui';
import { CATEGORIES } from '../tools/categories';
import { visibleCategories } from '../tools/registry';
import original from '../assets/home/original.webp';
import result from '../assets/home/result.webp';
import sample from '../assets/home/result.json';
import sailboatClip from '../assets/home/sailboat-gif-preview.mp4?url';
import sailboatPoster from '../assets/home/sailboat-gif-poster.webp';

const locale = localeOf(Astro.url.pathname);
const text = siteConfig.text[locale];
const t = ui(locale).home;
const href = (path: string) => localizePath(path, locale);
const kb = (bytes: number) => `${(bytes / 1000).toFixed(1)} KB`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: new URL(href('/'), Astro.site).href,
  description: text.description,
  inLanguage: locale,
};
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <RailShell>
    <div class="home">
      <HomeValueStory />

      <section class="home-how" aria-labelledby="how-title">
        <h2 id="how-title">{t.story.howTitle}</h2>
        <div class="how-intro">
          <p>{t.story.howProcess}</p>
          <p>{t.story.howFiles}</p>
        </div>
        <HomeLocalFlow />
        <a href={href('/safety/')}>
          {t.localMore} <span aria-hidden="true">↗</span>
        </a>
      </section>

      <aside class="home-data-note" aria-labelledby="data-note-title">
        <h2 id="data-note-title">{t.story.dataTitle}</h2>
        <p>{t.story.dataText}</p>
        <p>{t.story.dataReuse}</p>
      </aside>

      <section class="hero feature-intro" aria-labelledby="feature-title">
        <div class="hero-copy">
          <h2 id="feature-title">{t.featureTitle}</h2>
          <div class="hero-actions">
            <a class="primary" href={href('/image/target-size/')}>
              {t.primary}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <figure class="photo-example" aria-label={t.example}>
          <div class="photo-stage">
            <div class="photo photo-original">
              <Image src={original} alt={t.exampleAlt} width={416} height={624} loading="lazy" />
              <div class="photo-label">
                <span>{t.before}</span>
                <strong>{kb(sample.inputBytes)}</strong>
              </div>
            </div>
            <div class="photo photo-result">
              <Image src={result} alt={t.resultAlt} width={416} height={624} loading="lazy" />
              <div class="photo-label">
                <span>{t.after}</span>
                <strong>{kb(sample.outputBytes)}</strong>
              </div>
            </div>
          </div>
          <figcaption>
            <span>{t.sampleNote(siteConfig.name)}</span>
            <a
              href="https://unsplash.com/photos/green-plant-in-brown-clay-pot-6PkcqHAFsZA"
              rel="noreferrer"
            >
              {t.photoCredit}
            </a>
          </figcaption>
        </figure>
      </section>

      <section class="hero home-video" aria-labelledby="home-video-title">
        <div class="video-copy">
          <h2 id="home-video-title">{t.video.title}</h2>
          <p class="intro">{t.video.note}</p>
        </div>
        <video
          aria-label={t.video.playLabel}
          src={sailboatClip}
          poster={sailboatPoster.src}
          width="480"
          height="270"
          preload="none"
          controls
          playsinline
        ></video>
        <a class="video-tool" href={href('/video/to-gif/')}>
          {t.video.tool} <span aria-hidden="true">↗</span>
        </a>
      </section>

      <section id="examples" class="quick-tools" aria-labelledby="quick-title">
        <div class="section-heading">
          <h2 id="quick-title">{t.quickTitle}</h2>
          <p>{t.quickIntro}</p>
        </div>
        <HomeShowcase />
      </section>

      <!-- 실행 링크와 광고 사이에 최소 48px의 여백을 둔다. 슬롯이 비면 칸은 그리지 않는다. -->
      <div class="home-banner">
        <AdSlot id="top-banner" />
      </div>

      <section
        id="tools"
        class="directory"
        aria-labelledby="directory-title"
        aria-describedby="directory-intro"
      >
        <div class="section-heading">
          <div>
            <h2>{t.moreTitle}</h2>
            <p id="directory-intro">{t.moreIntro}</p>
          </div>
        </div>
        <div class="directory-heading">
          <h2 id="directory-title">{t.directory}</h2>
          <nav class="category-nav" aria-label={t.categoryNav}>
            {visibleCategories.map((category) => (
              <a href={`#tools-${category}`}>{CATEGORIES[category].text[locale].name}</a>
            ))}
          </nav>
        </div>
        {visibleCategories.map((category, index) => (
          <section
            id={`tools-${category}`}
            class="category"
            aria-labelledby={`category-${category}`}
          >
            <div class="category-heading">
              <h2 id={`category-${category}`}>
                <span class="category-number" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <a href={href(`/${category}/`)}>
                  {ui(locale).category.title(CATEGORIES[category].text[locale].name)}
                </a>
              </h2>
              <a
                class="category-more"
                href={href(`/${category}/`)}
                aria-label={ui(locale).nav.allTools(CATEGORIES[category].text[locale].name)}
              >
                {t.categoryLink} <span aria-hidden="true">↗</span>
              </a>
            </div>
            <ToolSections {category} headingLevel={3} compact />
          </section>
        ))}
      </section>

      <div class="home-in-content">
        <AdSlot id="in-content" />
      </div>

      <section class="guide-note" aria-labelledby="guide-title">
        <div>
          <h2 id="guide-title">{t.guideTitle}</h2>
          <p>{t.guideText}</p>
        </div>
        <a href={href('/guide/')}>
          {t.guideLink} <span aria-hidden="true">↗</span>
        </a>
      </section>
    </div>
  </RailShell>
</BaseLayout>

<style is:global>
  .home {
    padding-bottom: 32px;
  }
  .home .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    align-items: center;
    gap: clamp(26px, 5vw, 64px);
  }
  .home :is(.hero, .home-how, .quick-tools, .home-data-note) {
    padding-block: clamp(36px, 7vw, 88px);
    border-top: 1px solid var(--color-line);
  }
  .home :is(.hero, .home-how) h2 {
    margin: 0;
    font-size: clamp(27px, 4vw, 40px);
    line-height: 1.25;
    letter-spacing: -0.045em;
    word-break: keep-all;
    text-wrap: balance;
  }
  .home .home-how {
    text-align: center;
  }
  .home .how-intro {
    max-width: 37em;
    margin: 16px auto 28px;
    color: var(--color-muted);
    word-break: keep-all;
    text-wrap: balance;
  }
  .home .how-intro p {
    margin: 0;
  }
  .home .home-how > a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-top: 10px;
    font-size: 14px;
  }
  .home .feature-intro {
    padding-top: clamp(32px, 4.5vw, 56px);
  }
  .home .home-video {
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    grid-template-areas: 'clip copy' 'clip link';
    grid-template-rows: 1fr 1fr;
    row-gap: 12px;
  }
  .home .video-copy {
    grid-area: copy;
    align-self: end;
  }
  .home .video-tool {
    grid-area: link;
    display: inline-flex;
    align-self: start;
    justify-self: start;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 14px;
  }
  .home .home-video video {
    grid-area: clip;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    background: var(--color-video);
  }
  .home .home-data-note {
    padding-block: 32px;
  }
  .home .home-data-note h2 {
    margin: 0;
    font-size: 18px;
  }
  .home .home-data-note p {
    max-width: 56em;
    margin: 8px 0 0;
    color: var(--color-text);
    font-size: 14px;
    word-break: keep-all;
  }
  .home h1 {
    max-width: 8.5em;
    margin: 0;
    font-size: clamp(38px, 5.8vw, 67px);
    line-height: 1.2;
    letter-spacing: -0.055em;
    font-weight: 700;
    word-break: keep-all;
    text-wrap: balance;
  }
  .home .intro {
    max-width: 25em;
    margin: 24px 0 0;
    font-size: 16px;
    color: var(--color-muted);
    word-break: keep-all;
  }
  .home .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 28px;
  }
  .home .hero-actions a {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    min-height: 46px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }
  .home .primary {
    padding: 12px 18px;
    border-radius: var(--radius);
    background: var(--color-text);
    color: var(--color-bg);
  }
  .home .primary:hover {
    text-decoration: underline;
  }
  .home .photo-example {
    min-width: 0;
    margin: 0;
  }
  .home .photo-stage {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .home .photo {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .home .photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .home .photo-label {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 8px;
    padding: 8px 10px;
    font-size: 12px;
  }
  .home .photo-label strong {
    font: 600 13px var(--font-mono);
    white-space: nowrap;
  }
  .home figcaption {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 12px;
    text-align: center;
    color: var(--color-muted);
    font-size: 11px;
  }
  .home figcaption a {
    text-decoration-color: var(--color-line);
  }
  .home .quick-tools {
    scroll-margin-top: 24px;
  }
  .home .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }
  .home .section-heading h2 {
    margin: 0;
    font-size: 20px;
    letter-spacing: -0.03em;
  }
  .home .section-heading p {
    margin: 0;
    font-size: 13px;
    color: var(--color-muted);
  }
  .home .home-banner:has(.ad-slot),
  .home .home-in-content:has(.ad-slot) {
    margin: 48px 0;
  }
  .home .directory {
    margin-top: 72px;
    scroll-margin-top: 24px;
  }
  .home .directory-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--color-text);
  }
  .home .directory-heading h2 {
    margin: 0;
    font-size: 28px;
    letter-spacing: -0.04em;
  }
  .home .category-nav {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .home .category-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 6px 12px;
    border-radius: var(--radius);
    color: var(--color-muted);
    font-size: 13px;
    text-decoration: none;
  }
  .home .category-nav a:hover {
    background: var(--color-hover);
    color: var(--color-text);
  }
  .home .category {
    padding-top: 36px;
    scroll-margin-top: 16px;
  }
  .home .category + .category {
    margin-top: 36px;
    border-top: 1px solid var(--color-line);
  }
  .home .category-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 22px;
  }
  .home .category-heading h2 {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0;
    font-size: 23px;
    letter-spacing: -0.03em;
  }
  .home .category-heading a {
    text-decoration: none;
  }
  .home .category-heading a:hover {
    text-decoration: underline;
  }
  .home .category-number {
    font: 12px var(--font-mono);
    color: var(--color-accent);
  }
  .home .category-more {
    font-size: 12px;
    color: var(--color-muted);
    white-space: nowrap;
  }
  .home .guide-note h2 {
    margin: 0;
    font-size: 20px;
    letter-spacing: -0.03em;
  }
  .home .guide-note p {
    max-width: 43em;
    margin: 8px 0 0;
    color: var(--color-muted);
    font-size: 14px;
    word-break: keep-all;
  }
  .home .guide-note a {
    flex: none;
    margin-left: auto;
    font-size: 13px;
    text-decoration: none;
  }
  .home .guide-note a:hover {
    text-decoration: underline;
  }
  .home .guide-note {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 32px 0 16px;
  }
  @media (max-width: 767px) {
    .home .hero-actions {
      gap: 14px;
    }
    .home .directory-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }
    .home .category-nav {
      gap: 2px;
    }
    .home .category-nav a {
      padding: 6px 10px;
    }
    .home .guide-note {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }
    .home .guide-note a {
      margin: 0;
    }
  }
  @media (max-width: 599px) {
    .home .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .home .home-video {
      grid-template-areas: 'copy' 'clip' 'link';
      grid-template-rows: auto;
      gap: 16px;
    }
    .home .intro {
      max-width: 24em;
      margin-top: 16px;
      font-size: 15px;
    }
    .home .hero-actions {
      margin-top: 22px;
      gap: 24px;
    }
    .home .section-heading {
      display: block;
    }
    .home .section-heading h2 {
      font-size: 19px;
    }
    .home .section-heading p {
      margin-top: 4px;
    }
    .home .directory {
      margin-top: 48px;
    }
    .home .directory-heading h2 {
      font-size: 25px;
    }
    .home .category-heading h2 {
      font-size: 21px;
    }
  }
</style>
<style is:global>
  /* 홈에서만 설명을 짧게 보여준다. 다른 목록·도구 페이지 스타일은 유지한다. */
  .home .card {
    gap: 12px;
    padding: 18px 16px;
  }
  .home .card .icon {
    width: 34px;
    height: 34px;
    background: transparent;
  }
  .home .card .name {
    font-size: 15px;
  }
  .home .card .desc {
    margin-top: 5px;
    font-size: 12px;
    line-height: 1.6;
  }
</style>
