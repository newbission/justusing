---
/**
 * 허브: 전체 도구 목록. 카테고리와 도구는 레지스트리에서 자동으로 채운다.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolGrid from '../components/ToolGrid.astro';
import RailShell from '../components/RailShell.astro';
import { siteConfig } from '../site.config';
import { CATEGORIES } from '../tools/categories';
import { toolsInCategory, visibleCategories } from '../tools/registry';
---

<BaseLayout>
  <RailShell>
    <section class="hero">
      <h1>{siteConfig.tagline}</h1>
      <p class="lead">{siteConfig.description}</p>
      <ul class="promises">
        <li>
          <strong>업로드 없음</strong> 파일은 내 기기를 떠나지 않습니다
        </li>
        <li>
          <strong>설치·가입 없음</strong> 브라우저만 있으면 됩니다
        </li>
        <li>
          <strong>무료</strong> 횟수 제한 없이 쓸 수 있습니다
        </li>
      </ul>
    </section>

    {visibleCategories.map((category) => (
      <section class="category">
        <h2>
          <a href={`/${category}/`}>{CATEGORIES[category].text.ko.name} 도구</a>
        </h2>
        <ToolGrid tools={toolsInCategory(category)} headingLevel={3} />
      </section>
    ))}
  </RailShell>
</BaseLayout>

<style>
  .hero {
    padding: 48px 0 32px;
  }
  h1 {
    margin: 0;
    font-size: clamp(26px, 5vw, 36px);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .lead {
    margin: 12px 0 0;
    color: var(--color-muted);
  }
  .promises {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    color: var(--color-muted);
    font-size: 14px;
  }
  .promises strong {
    margin-right: 6px;
    color: var(--color-accent);
  }
  .category {
    margin-top: 16px;
  }
  .category h2 {
    margin: 0 0 16px;
    font-size: 20px;
  }
  .category h2 a {
    text-decoration: none;
  }
  .category h2 a:hover {
    text-decoration: underline;
  }
</style>
