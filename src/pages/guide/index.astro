---
/**
 * 가이드 목록 (/guide/). 글마다 제목·설명과 안내하는 도구 아이콘을 카드로 보여준다.
 */
import DocLayout from '../../layouts/DocLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import GuideCards from '../../components/GuideCards.astro';
import { guidesIn } from '../../guides';
import { localeOf } from '../../i18n/locales';
import { ui } from '../../i18n/ui';

const locale = localeOf(Astro.url.pathname);
const t = ui(locale).guide;
const guides = guidesIn(locale);
---

<DocLayout title={t.indexTitle} description={t.indexDescription}>
  <p>{t.indexDescription}</p>
  <div class="list">
    <GuideCards {guides} />
  </div>

  <Fragment slot="after">
    <div class="in-content">
      <AdSlot id="in-content" />
    </div>
  </Fragment>
</DocLayout>

<style>
  .list {
    margin-top: 24px;
  }
  .in-content {
    margin: 48px 0;
  }
  .in-content:not(:has(.ad-slot)) {
    margin: 0;
  }
</style>
