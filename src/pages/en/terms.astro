---
/**
 * 영어 이용약관 (/en/terms/). 한국어 약관(src/pages/terms.astro)과 같은 내용이다.
 * 두 언어가 다를 때는 한국어판이 기준임을 밝힌다.
 */
import DocLayout from '../../layouts/DocLayout.astro';
import { contactEmail, siteConfig } from '../../site.config';

/** 한국어판과 같은 날로 둔다 */
const effectiveDate = 'October 13, 2026';
---

<DocLayout
