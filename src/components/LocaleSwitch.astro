---
/**
 * 언어 바꾸기 (머리글). 지금 페이지의 다른 언어판으로 간다.
 * 누르면 고른 언어를 localStorage에 저장해, 다음부터는 브라우저 언어 대신 이 언어로 연다 (LocaleRedirect).
 */
import {
  LOCALE_INFO,
  LOCALE_STORAGE_KEY,
  LOCALES,
  localeOf,
  localizePath,
  withoutLocale,
} from '../i18n/locales';
import { ui } from '../i18n/ui';

const locale = localeOf(Astro.url.pathname);
const path = withoutLocale(Astro.url.pathname);
const others = LOCALES.filter((other) => other !== locale);
---

<nav class="locale-switch" aria-label={ui(locale).nav.language}>
  {others.map((other) => (
    <a
      href={localizePath(path, other)}
      hreflang={other}
      lang={other}
      data-locale-switch={other}
      data-storage-key={LOCALE_STORAGE_KEY}
    >
      {LOCALE_INFO[other].label}
    </a>
  ))}
</nav>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-locale-switch]')) {
    link.addEventListener('click', () => {
      try {
        localStorage.setItem(link.dataset.storageKey!, link.dataset.localeSwitch!);
      } catch {
        // 저장이 막혀도 링크로 그 언어 페이지에는 간다
      }
    });
  }
</script>

<style>
  .locale-switch a {
    display: inline-grid;
    place-items: center;
    height: 40px;
    padding: 0 12px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    color: var(--color-muted);
    font-size: 14px;
    text-decoration: none;
  }
  .locale-switch a:hover {
    border-color: var(--color-muted);
    color: var(--color-text);
  }
</style>
