---
/**
 * 광고 칸. 위치 ID만 받고, 크기는 src/ads/slots.css가 data-ad-slot 값으로 정한다.
 *
 * - 광고 켜짐 + 이 슬롯 설정 있음: 크기를 미리 확보한 빈 칸 (업체 스크립트가 채움)
 * - 개발 모드(npm run dev)에서 꺼져 있으면: 위치 확인용 점선 칸
 *   (배포용 빌드도 SHOW_AD_PLACEHOLDERS=1 로 빌드하면 점선 칸을 보여준다. 실제 배포에는 쓰지 않는다)
 * - 배포 화면에서 꺼져 있으면: 아무것도 그리지 않는다 (빌드 때 결정되므로 화면이 밀리지 않음)
 */
import '../ads/slots.css';
import type { AdSlotId } from '../ads/slots';
import { siteConfig } from '../site.config';

interface Props {
  id: AdSlotId;
}

const { id } = Astro.props;
const slot = siteConfig.ads.enabled ? siteConfig.ads.slots[id] : undefined;
const showPlaceholder = !slot && (import.meta.env.DEV || process.env.SHOW_AD_PLACEHOLDERS === '1');
---

{slot && (
  <aside
    class="ad-slot"
    aria-label="광고"
    data-ad-slot={id}
    data-ad-provider={slot.provider}
    data-ad-unit={slot.unit}
  />
)}

{showPlaceholder && (
  <div class="ad-slot ad-placeholder" data-ad-slot={id} aria-hidden="true">
    광고 · {id}
  </div>
)}

<style>
  .ad-slot {
    width: min(var(--ad-w), 100%);
    height: var(--ad-h);
    margin-inline: auto;
    overflow: hidden;
  }
  .ad-placeholder {
    display: grid;
    place-items: center;
    border: 1px dashed var(--color-muted);
    border-radius: var(--radius);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  @media (max-width: 767px) {
    .ad-slot {
      width: min(var(--ad-w-m), 100%);
      height: var(--ad-h-m);
    }
  }
</style>
