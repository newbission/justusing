---
/**
 * 도구 페이지의 '사용법' 섹션. 단계를 번호 목록으로 보여준다.
 */
import { localeOf } from '../i18n/locales';
import { ui } from '../i18n/ui';

interface Props {
  name: string;
  steps: string[];
}

const { name, steps } = Astro.props;
const t = ui(localeOf(Astro.url.pathname)).tool;
---

<section class="how-to">
  <h2>{t.howTo(name)}</h2>
  <ol>
    {steps.map((step) => (
      <li>{step}</li>
    ))}
  </ol>
</section>

<style>
  h2 {
    margin: 0 0 12px;
    font-size: 22px;
  }
  ol {
    margin: 0;
    padding-left: 1.4em;
  }
  li + li {
    margin-top: 6px;
  }
</style>
