---
import { siteConfig } from '../site.config';
import { localeOf, localizePath } from '../i18n/locales';
import { ui } from '../i18n/ui';

const year = new Date().getFullYear();

/** 바닥글 링크. 글 페이지를 만들 때마다 여기에 더한다. */
const locale = localeOf(Astro.url.pathname);
const t = ui(locale).footer;
const links = [
  { name: ui(locale).nav.guides, href: '/guide/' },
  { name: t.about, href: '/about/' },
  { name: t.privacy, href: '/privacy/' },
  { name: t.terms, href: '/terms/' },
  { name: t.contact, href: '/contact/' },
].map((link) => ({ ...link, href: localizePath(link.href, locale) }));
---

<footer class="site-footer">
  <div class="inner">
    <p>{t.localNote}</p>
    <nav aria-label={t.siteInfo}>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.name}</a>
          </li>
        ))}
      </ul>
    </nav>
    <p>
      © {year} {siteConfig.name}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 64px;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 14px;
  }
  .inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 24px var(--gutter);
  }
  p {
    margin: 0 0 4px;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 12px 0;
    padding: 0;
    list-style: none;
  }
  /* 휴대폰에서 누르기 쉽게 위아래로 넉넉히 */
  a {
    display: inline-block;
    padding: 6px 0;
    text-decoration: none;
  }
  a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }
</style>
