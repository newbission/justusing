---
/** 받는 공개 처리 파일과 기기 안에 머무는 사용자 파일을 구분하는 정적 도식. */
import { localeOf } from '../i18n/locales';
import { ui } from '../i18n/ui';
const t = ui(localeOf(Astro.url.pathname)).home.localFlow;
---

<figure class="local-proof">
  <div class="proof-source">
    <strong>{t.source}</strong>
    <span>{t.download}</span>
    <span aria-hidden="true">↓</span>
  </div>
  <div class="proof-device">
    <strong>{t.device}</strong>
    <div class="proof-browser">
      <span>{t.browser}</span>
      <div class="proof-tool">
        <strong>{t.toolArea}</strong>
        <ol class="proof-steps">
          <li>
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
              <path d="M6 3h8l4 4v14H6zM14 3v5h4M9 12h6m-6 4h6" />
            </svg>
            <span>{t.choose}</span>
          </li>
          <li>
            <span class="proof-next" aria-hidden="true">
              →
            </span>
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
              <path d="M7 6h10v12H7zM10 3v3m4-3v3m-4 12v3m4-3v3M3 10h4m-4 4h4m10-4h4m-4 4h4m-11-3 2 2 3-4" />
            </svg>
            <span>{t.process.join(' ')}</span>
          </li>
          <li>
            <span class="proof-next" aria-hidden="true">
              →
            </span>
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
              <path d="M6 3h8l4 4v14H6zM14 3v5h4M12 10v7m-3-3 3 3 3-3" />
            </svg>
            <span>{t.save}</span>
          </li>
        </ol>
      </div>
      <p class="proof-outside">{t.outside}</p>
    </div>
  </div>
  <figcaption>{t.alt}</figcaption>
</figure>

<style is:global>
  .home .local-proof {
    margin: 0;
    font-size: 14px;
    word-break: keep-all;
  }
  .home .proof-source {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-bottom: 8px;
    color: var(--color-muted);
  }
  .home .proof-source > span:last-child {
    color: var(--color-accent);
    font-size: 24px;
    line-height: 1;
  }
  .home .proof-device {
    padding: 12px;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    background: var(--color-accent-soft);
  }
  .home .proof-browser {
    margin-top: 12px;
    padding: 10px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .home .proof-browser > span {
    color: var(--color-muted);
  }
  .home .proof-tool {
    margin-top: 12px;
    padding: 10px;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
  }
  .home .proof-tool > strong {
    color: var(--color-accent);
  }
  .home .proof-steps {
    display: flex;
    gap: 8px;
    padding: 0;
    margin: 20px 0 8px;
    list-style: none;
  }
  .home .proof-steps li {
    position: relative;
    flex: 1;
    min-width: 0;
    text-align: center;
  }
  .home .proof-steps span {
    display: block;
    margin-top: 8px;
  }
  .home .proof-steps .proof-next {
    position: absolute;
    top: 2px;
    left: -12px;
    margin: 0;
    color: var(--color-accent);
  }
  .home .proof-steps svg {
    margin-inline: auto;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .home .proof-outside {
    margin: 12px 0 0;
    color: var(--color-muted);
  }
</style>
