---
/**
 * 광고 차단 안내 창. 광고 차단이 켜진 방문자에게 꺼 달라고 부탁한다 (site.config의 ads.adblockNotice).
 *
 * - 광고 차단을 알아챘을 때(AdsScript의 adblock 이벤트)와 도구를 쓸 때마다(ToolFrame의 toolactivity
 *   이벤트) 뜬다. 페이지를 옮기면 다시 알아채므로 어느 페이지에서나 뜬다.
 * - 언제든 닫을 수 있다 (오른쪽 위 ×, 닫기 버튼, Esc, 창 바깥 누르기). 닫아도 하던 일은 그대로 된다.
 * - 창 안에는 광고를 두지 않는다. 바깥 페이지에만 있고 도구 frame과는 무관하다.
 */
import { siteConfig } from '../site.config';
---

{siteConfig.ads.adblockNotice && (
  <dialog class="adblock" aria-labelledby="adblock-title" data-adblock-notice>
    <button type="button" class="close" aria-label="닫기" data-adblock-close>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path d="M3 3l10 10M13 3L3 13" />
      </svg>
    </button>
    <h2 id="adblock-title">광고 차단을 꺼 주세요</h2>
    <p>
      {siteConfig.name}은 광고 수익으로 무료로 운영됩니다. 이 사이트에서는 광고 차단 프로그램을 꺼
      주세요.
    </p>
    <p class="muted">광고는 도구 화면 바깥에만 있어서 파일 내용을 볼 수 없습니다.</p>
    <div class="actions">
      <button type="button" data-adblock-close>
        닫기
      </button>
      <button type="button" class="primary" data-adblock-reload>
        껐어요, 새로 고침
      </button>
    </div>
  </dialog>
)}

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-adblock-notice]');

  if (dialog) {
    const show = () => {
      if ('adblock' in document.documentElement.dataset && !dialog.open) dialog.showModal();
    };
    document.addEventListener('adblock', show);
    document.addEventListener('toolactivity', show);
    show(); // 이 스크립트보다 먼저 알아챈 경우

    for (const button of dialog.querySelectorAll('[data-adblock-close]')) {
      button.addEventListener('click', () => dialog.close());
    }
    dialog.querySelector('[data-adblock-reload]')?.addEventListener('click', () => {
      location.reload();
    });
    // 창 바깥(어두운 곳)을 눌러도 닫는다
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .adblock {
    width: min(420px, calc(100vw - 2 * var(--gutter)));
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 0 8px 40px rgb(0 0 0 / 0.24);
  }
  .adblock::backdrop {
    background: rgb(0 0 0 / 0.4);
  }
  /* 안쪽 여백은 dialog가 아니라 내용에 둔다 (dialog 자체를 누른 것 = 바깥을 누른 것으로 알아채려고) */
  .adblock[open] {
    display: grid;
    gap: 12px;
    padding: 24px;
  }
  h2 {
    margin: 0;
    padding-right: 32px;
    font-size: 18px;
    line-height: 1.4;
  }
  p {
    margin: 0;
  }
  .muted {
    color: var(--color-muted);
    font-size: 14px;
  }
  .actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 8px;
  }
  button {
    height: 40px;
    padding: 0 16px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: transparent;
    cursor: pointer;
    transition:
      background-color 0.12s,
      border-color 0.12s;
  }
  button:hover {
    border-color: var(--color-muted);
    background: var(--color-hover);
  }
  button.primary {
    border-color: var(--color-text);
    background: var(--color-text);
    color: var(--color-bg);
    font-weight: 600;
  }
  button.primary:hover {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }
  .close {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border-color: transparent;
    color: var(--color-muted);
  }
  .close path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  @media (max-width: 480px) {
    .actions {
      flex-direction: column-reverse;
    }
  }
</style>
