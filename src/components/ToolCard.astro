---
/**
 * 도구 카드. live 도구는 페이지 링크, soon 도구는 '준비 중' 표시만 하고 누를 수 없다.
 */
import type { Tool } from '../tools/registry';
import { localeOf, localizePath } from '../i18n/locales';
import { ui } from '../i18n/ui';

interface Props {
  tool: Tool;
  /** 카드 제목의 제목 수준. 페이지 구조에 맞춰 h2/h3를 고른다. */
  headingLevel?: 2 | 3;
}

const { tool, headingLevel = 3 } = Astro.props;
const locale = localeOf(Astro.url.pathname);
const text = tool.text[locale];
const Heading = `h${headingLevel}` as const;
const live = tool.status === 'live';
---

{live ? (
  <a class="card" href={localizePath(tool.href, locale)}>
    <Heading class="name">{text.name}</Heading>
    <p class="desc">{text.description}</p>
  </a>
) : (
  <div class="card soon">
    <Heading class="name">
      {text.name}
      <span class="badge">{ui(locale).nav.soon}</span>
    </Heading>
    <p class="desc">{text.description}</p>
  </div>
)}

<style>
  .card {
    display: block;
    height: 100%;
    padding: 20px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
    text-decoration: none;
  }
  a.card:hover {
    border-color: var(--color-text);
  }
  .name {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 17px;
  }
  .desc {
    margin: 8px 0 0;
    color: var(--color-muted);
    font-size: 14px;
  }
  .soon .name {
    color: var(--color-muted);
  }
  .badge {
    padding: 2px 8px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-muted);
    font-size: 12px;
    font-weight: 400;
  }
</style>
