---
/**
 * 가이드 카드 목록. 글마다 제목·설명과 안내하는 도구의 아이콘을 보여준다 (가이드 목록·카테고리 가이드 페이지).
 */
import ToolIcon from './ToolIcon.astro';
import type { Guide } from '../guides';
import { slugOf } from '../guides';
import { localeOf, localizePath } from '../i18n/locales';
import { getTool } from '../tools/registry';

interface Props {
  guides: Guide[];
}

const locale = localeOf(Astro.url.pathname);
---

<ul class="guides">
  {Astro.props.guides.map((guide) => (
    <li>
      <a class="card" href={localizePath(`/guide/${slugOf(guide)}/`, locale)}>
        <span class="icon">
          <ToolIcon paths={getTool(guide.data.tool)!.icon} />
        </span>
        <span class="body">
          <strong>{guide.data.title}</strong>
          <span>{guide.data.description}</span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  /* 글 페이지 본문(.doc)의 목록 들여쓰기·간격을 쓰지 않는다 */
  :global(.doc) .guides {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(.doc) .guides li {
    margin: 0;
  }
  .card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 18px 20px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color 0.12s;
  }
  .card:hover {
    border-color: var(--color-muted);
  }
  .icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .body strong {
    font-size: 17px;
  }
  .body span {
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.5;
  }
</style>
