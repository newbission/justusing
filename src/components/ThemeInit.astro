---
/**
 * <head> 안에서 화면을 그리기 전에 저장된 테마를 적용한다.
 * 이게 없으면 다크 모드 사용자에게 흰 화면이 잠깐 번쩍인다.
 * 저장값이 없으면 아무것도 하지 않고 OS 설정을 따른다.
 */
import { THEME_STORAGE_KEY } from '../lib/theme';
---

<script is:inline define:vars={{ key: THEME_STORAGE_KEY }}>
  try {
    const saved = localStorage.getItem(key);
    if (saved === 'light' || saved === 'dark') {
      document.documentElement.dataset.theme = saved;
    }
  } catch {
    // 사생활 보호 모드 등에서 저장소 접근이 막혀도 OS 설정으로 동작
  }
</script>
