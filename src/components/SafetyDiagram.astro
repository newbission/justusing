---
/**
 * "왜 안전한가요" 그림 설명. 글로만 쓴 약속을 한눈에 보이게 한다 (홈·소개 페이지).
 *
 * 그림 1: 보통 온라인 도구는 파일을 서버로 올리지만, 이 사이트는 내 기기 안에서 끝낸다.
 * 그림 2: 광고가 있어도 도구 화면은 따로 잠긴 방이라 광고가 파일을 볼 수 없다.
 *
 * 실제 구현과 어긋나는 그림을 그리지 않는다 (도구 격리: ToolFrame.astro, FrameLayout.astro).
 * 그림은 꾸밈이고(aria-hidden), 같은 내용을 아래 글(figcaption)로도 적는다.
 */
import { localeOf } from '../i18n/locales';
import { ui } from '../i18n/ui';
import { siteConfig } from '../site.config';

interface Props {
  /** 제목 단계 (홈은 2, 소개 페이지 본문 안에서는 2) */
  headingLevel?: 2 | 3;
}

const { headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const t = ui(localeOf(Astro.url.pathname)).safety;
---

<section class="safety" aria-labelledby="safety-title">
  <Heading id="safety-title" class="title">
    {t.title}
  </Heading>

  <div class="cards">
    <figure>
      <div class="art" aria-hidden="true">
        <div class="row">
          <span class="row-label">{t.others}</span>
          <div class="flow">
            <div class="node">
              <svg viewBox="0 0 24 24" class="icon">
                <path d="M4 5h16v11H4zM9 20h6M12 16v4" />
              </svg>
              <span>{t.myDevice}</span>
            </div>
            <div class="arrow">
              <span>{t.upload}</span>
              <svg viewBox="0 0 64 12" preserveAspectRatio="none">
                <path d="M0 6h58M52 1l6 5-6 5" />
              </svg>
            </div>
            <div class="node warn">
              <svg viewBox="0 0 24 24" class="icon">
                <path d="M4 4h16v6H4zM4 14h16v6H4zM8 7h.01M8 17h.01" />
              </svg>
              <span>{t.theirServer}</span>
              <small>{t.fileStays}</small>
            </div>
          </div>
        </div>

        <div class="row">
          <span class="row-label ours">{siteConfig.name}</span>
          <div class="flow">
            <div class="node good">
              <svg viewBox="0 0 24 24" class="icon">
                <path d="M4 5h16v11H4zM9 20h6M12 16v4" />
              </svg>
              <span>{t.myDevice}</span>
              <small>{t.doneHere}</small>
            </div>
            <div class="arrow blocked">
              <span>{t.noTransfer}</span>
              <svg viewBox="0 0 64 12" preserveAspectRatio="none">
                <path d="M0 6h20M44 6h20" class="dash" />
                <path d="M27 1l10 10M37 1L27 11" />
              </svg>
            </div>
            <div class="node faded">
              <svg viewBox="0 0 24 24" class="icon">
                <path d="M4 4h16v6H4zM4 14h16v6H4zM8 7h.01M8 17h.01" />
              </svg>
              <span>{t.server}</span>
              <small>{t.fileNeverArrives}</small>
            </div>
          </div>
        </div>
      </div>
      <figcaption>
        <strong>{t.localTitle}</strong>
        <p>{t.localText}</p>
      </figcaption>
    </figure>

    <figure>
      <div class="art" aria-hidden="true">
        <div class="window">
          <div class="window-bar">
            <i></i>
            <i></i>
            <i></i>
          </div>
          <div class="window-body">
            <div class="room">
              <svg viewBox="0 0 24 24" class="icon">
                <path d="M6 11h12v9H6zM8.5 11V8a3.5 3.5 0 0 1 7 0v3" />
              </svg>
              <span>{t.toolScreen}</span>
              <small>{t.filesOnlyHere}</small>
            </div>
            <div class="wall"></div>
            <div class="outside">
              <div class="ad">{t.ad}</div>
              <div class="ad">{t.ad}</div>
              <small>{t.cannotSeeThrough}</small>
            </div>
          </div>
        </div>
      </div>
      <figcaption>
        <strong>{t.adsTitle}</strong>
        <p>{t.adsText}</p>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .title {
    margin: 0 0 16px;
    font-size: 20px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  figure {
    display: flex;
    flex-direction: column;
    margin: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
    overflow: hidden;
  }
  .art {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    padding: 24px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-bg);
    font-size: 13px;
  }
  figcaption {
    padding: 20px 24px 24px;
  }
  figcaption strong {
    display: block;
    font-size: 18px;
  }
  figcaption p {
    margin: 6px 0 0;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .icon {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  small {
    color: var(--color-muted);
    font-size: 12px;
  }

  /* 그림 1: 파일이 가는 길 */
  .row-label {
    display: block;
    margin-bottom: 8px;
    color: var(--color-muted);
    font-weight: 600;
  }
  .row-label.ours {
    color: var(--color-accent);
  }
  .flow {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .node {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    min-width: 0;
    padding: 12px 8px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
    text-align: center;
    font-weight: 600;
  }
  .node small {
    font-weight: 400;
  }
  .node.good {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }
  .node.good small {
    color: inherit;
  }
  .node.warn {
    border-style: dashed;
    border-color: var(--color-muted);
  }
  .node.faded {
    opacity: 0.5;
  }
  .arrow {
    display: flex;
    flex: 0 0 72px;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: var(--color-muted);
    font-size: 12px;
  }
  .arrow svg {
    width: 100%;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .arrow.blocked {
    color: var(--color-accent);
    font-weight: 600;
  }
  .arrow .dash {
    stroke-dasharray: 3 4;
  }

  /* 그림 2: 브라우저 창 안의 잠긴 방 */
  .window {
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
    overflow: hidden;
  }
  .window-bar {
    display: flex;
    gap: 5px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--color-line);
  }
  .window-bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-line);
  }
  .window-body {
    display: flex;
    align-items: stretch;
    gap: 10px;
    padding: 14px;
  }
  .room {
    display: flex;
    flex: 3 1 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-width: 0;
    padding: 20px 8px;
    border: 2px solid var(--color-accent);
    border-radius: var(--radius);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    text-align: center;
    font-weight: 600;
  }
  .room small {
    color: inherit;
    font-weight: 400;
  }
  .wall {
    display: grid;
    flex: none;
    place-items: center;
    width: 18px;
    border-radius: 3px;
    background: repeating-linear-gradient(
      45deg,
      var(--color-muted),
      var(--color-muted) 3px,
      transparent 3px,
      transparent 7px
    );
  }
  .outside {
    display: flex;
    flex: 2 1 0;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    text-align: center;
  }
  .ad {
    display: grid;
    flex: 1;
    place-items: center;
    min-height: 32px;
    border: 1px dashed var(--color-muted);
    border-radius: var(--radius);
    color: var(--color-muted);
  }

  @media (max-width: 719px) {
    .cards {
      grid-template-columns: 1fr;
    }
    .art {
      padding: 16px;
    }
    figcaption {
      padding: 16px;
    }
    figcaption strong {
      font-size: 16px;
    }
    .arrow {
      flex-basis: 56px;
    }
  }
</style>
