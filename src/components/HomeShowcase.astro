---
/** 공개 견본으로 재현하는 주요 동작. 실제 결과 sprite만 쓰며 파일 처리 코드는 불러오지 않는다. */
import { Image } from 'astro:assets';
import { localeOf, localizePath } from '../i18n/locales';
import { ui } from '../i18n/ui';
import { getTool } from '../tools/registry';
import albumInput from '../assets/home/scenes/album-input.webp';
import albumPages from '../assets/home/scenes/album-pages.webp';
import plant from '../assets/home/original.webp';
import cutout from '../assets/home/scenes/plant-cutout.webp';
import docsKo from '../assets/home/scenes/document-pages-ko.webp';
import docsEn from '../assets/home/scenes/document-pages-en.webp';
import redactKo from '../assets/home/scenes/redaction-ko.webp';
import redactEn from '../assets/home/scenes/redaction-en.webp';

const locale = localeOf(Astro.url.pathname);
const t = ui(locale).home;
const m = t.motion;
const docs = locale === 'ko' ? docsKo : docsEn;
const redaction = locale === 'ko' ? redactKo : redactEn;
const scenes = [
  { key: 'album', tool: 'pdf/from-image' },
  { key: 'cutout', tool: 'image/remove-bg' },
  { key: 'merge', tool: 'pdf/merge' },
  { key: 'redact', tool: 'pdf/redact' },
] as const;
---

<div class="home-showcase">
  <div class="showcase-stories">
    {scenes.map((scene, index) => {
      const copy = m[scene.key];
      const tool = getTool(scene.tool)!;
      return (
        <article
          class="feature-demo"
          data-demo={scene.key}
          data-playback="idle"
          aria-labelledby={`demo-${scene.key}`}
        >
          <div class="demo-copy">
            <p class="demo-number">
              {String(index + 1).padStart(2, '0')} / {tool.text[locale].name}
            </p>
            <h3 id={`demo-${scene.key}`}>{copy.title}</h3>
            <p class="demo-description">{copy.text}</p>
          </div>
          <div class="demo-visual">
            <div class={`demo-stage scene-${scene.key}`} role="img" aria-label={copy.alt}>
              <div class="scene-labels" aria-hidden="true">
                <span>{copy.input}</span>
                <span>{copy.output}</span>
              </div>
              {scene.key === 'album' && (
                <>
                  <div class="album-inputs" aria-hidden="true">
                    {[0, 1, 2].map((page) => (
                      <div class={`input-photo item-${page}`}>
                        <div class="sprite-window">
                          <Image
                            src={albumInput}
                            width={720}
                            height={300}
                            alt=""
                            class={`sprite sprite-three position-${page}`}
                            loading="lazy"
                          />
                        </div>
                        <span>{String(page + 1).padStart(2, '0')}</span>
                      </div>
                    ))}
                  </div>
                  <span class="scene-arrow" aria-hidden="true">
                    →
                  </span>
                  <div class="pdf-viewer album-output" aria-hidden="true">
                    <div class="viewer-heading">
                      <b>PDF</b>
                      <span>
                        {m.oneFile} · 3{locale === 'ko' ? m.pages : ` ${m.pages}`}
                      </span>
                    </div>
                    <div class="viewer-body">
                      <div class="page-rail">
                        {[0, 1, 2].map((page) => (
                          <div class="rail-page">
                            <Image
                              src={albumPages}
                              width={630}
                              height={297}
                              alt=""
                              class={`sprite sprite-three position-${page}`}
                              loading="lazy"
                            />
                          </div>
                        ))}
                      </div>
                      <div class="page-window">
                        {[0, 1, 2].map((page) => (
                          <div class={`pdf-page page-${page}`}>
                            <Image
                              src={albumPages}
                              width={630}
                              height={297}
                              alt=""
                              class={`sprite sprite-three position-${page}`}
                              loading="lazy"
                            />
                          </div>
                        ))}
                      </div>
                    </div>
                    <div class="page-indicator">
                      {[0, 1, 2].map((page) => (
                        <span class={`indicator-${page}`}>{page + 1} / 3</span>
                      ))}
                    </div>
                  </div>
                </>
              )}
              {scene.key === 'cutout' && (
                <>
                  <div class="subject-photo" aria-hidden="true">
                    <Image src={plant} width={560} height={840} alt="" loading="lazy" />
                    <span class="subject-selection">
                      <span>+</span>
                    </span>
                    <span class="subject-label">{m.subject}</span>
                  </div>
                  <span class="scene-arrow" aria-hidden="true">
                    →
                  </span>
                  <div class="cutout-output checkerboard" aria-hidden="true">
                    <Image src={cutout} width={260} height={390} alt="" loading="lazy" />
                    <b>PNG</b>
                  </div>
                  <span class="transparency-note" aria-hidden="true">
                    {m.transparent}
                  </span>
                </>
              )}
              {scene.key === 'merge' && (
                <>
                  <div class="merge-inputs" aria-hidden="true">
                    {[0, 1].map((page) => (
                      <div class={`merge-source source-${page}`}>
                        <div class="mini-document">
                          <Image
                            src={docs}
                            width={420}
                            height={297}
                            alt=""
                            class={`sprite sprite-two position-${page}`}
                            loading="lazy"
                          />
                        </div>
                        <span>{page === 0 ? m.report : m.appendix}</span>
                      </div>
                    ))}
                  </div>
                  <span class="scene-arrow" aria-hidden="true">
                    →
                  </span>
                  <div class="pdf-viewer merge-output" aria-hidden="true">
                    <div class="viewer-heading">
                      <b>PDF</b>
                      <span>
                        {m.oneFile} · 6{locale === 'ko' ? m.pages : ` ${m.pages}`}
                      </span>
                    </div>
                    <div class="merged-page">
                      <Image
                        src={docs}
                        width={420}
                        height={297}
                        alt=""
                        class="sprite sprite-two position-0"
                        loading="lazy"
                      />
                    </div>
                    <div class="merge-order">
                      <span>1—4</span>
                      <span>5—6</span>
                    </div>
                  </div>
                </>
              )}
              {scene.key === 'redact' && (
                <>
                  <div class="redact-document" aria-hidden="true">
                    <div class="excerpt-heading">
                      <span>PDF</span>
                      <span>{m.excerpt}</span>
                    </div>
                    <div class="document-lines">
                      <i></i>
                      <i></i>
                    </div>
                    <div class="redact-window">
                      <div class="redact-before">
                        <Image
                          src={redaction}
                          width={redaction.width}
                          height={redaction.height}
                          alt=""
                          class="sprite sprite-two position-0"
                          loading="lazy"
                        />
                      </div>
                      <div class="redact-after">
                        <Image
                          src={redaction}
                          width={redaction.width}
                          height={redaction.height}
                          alt=""
                          class="sprite sprite-two position-1"
                          loading="lazy"
                        />
                      </div>
                      <div class="redact-selection"></div>
                    </div>
                    <div class="document-lines">
                      <i></i>
                      <i></i>
                      <i></i>
                    </div>
                  </div>
                  <span class="redact-result" aria-hidden="true">
                    {copy.output} <span>✓</span>
                  </span>
                </>
              )}
            </div>
            <ol class="demo-steps" aria-label={copy.title}>
              {copy.steps.map((step, i) => (
                <li>
                  <span aria-hidden="true">{i + 1}</span>
                  {step}
                </li>
              ))}
            </ol>
          </div>
          <div class="demo-actions">
            <button
              type="button"
              class="motion-control"
              data-motion-control
              hidden
              data-play={m.play}
              data-pause={m.pause}
              data-resume={m.resume}
              data-replay={m.replay}
              data-finished={m.finished}
              aria-describedby={`demo-${scene.key}`}
            >
              <span class="control-icon" aria-hidden="true">
                ▷
              </span>
              <span data-control-label>{m.play}</span>
            </button>
            <span class="reduced-note">{m.reduced}</span>
            <a class="demo-tool-link" href={localizePath(tool.href, locale)}>
              {tool.text[locale].name}
              <span aria-hidden="true">↗</span>
            </a>
            <span class="demo-status" aria-live="polite"></span>
          </div>
        </article>
      );
    })}
  </div>
  <p class="showcase-note">{t.showcaseNote}</p>
  <p class="showcase-credits">
    {t.showcaseCredit}:{' '}
    <a
      href="https://unsplash.com/photos/green-plant-in-brown-clay-pot-6PkcqHAFsZA"
      rel="noreferrer"
    >
      Patrick Pahlke
    </a>
    <span aria-hidden="true">·</span>
    <a href="https://unsplash.com/photos/coastal-cliffs-over-sea-xYbl6lHASw8" rel="noreferrer">
      Erik Esly
    </a>
    <span aria-hidden="true">·</span>
    <a href="https://unsplash.com/photos/a-vase-with-yellow-flowers-PpAEAT6jEnw" rel="noreferrer">
      Yana Hurska
    </a>{' '}
    / Unsplash
  </p>
</div>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const demos = [...document.querySelectorAll<HTMLElement>('[data-demo]')];
  const visible = new Set<HTMLElement>();
  const pending = new Set<HTMLElement>();
  const autoplay = new Map<HTMLElement, () => void>();
  const hasPlaying = () => demos.some((demo) => demo.dataset.playback === 'playing');
  const playVisible = () => {
    if (reduced.matches || document.hidden || hasPlaying() || pending.size) return;
    for (const demo of demos) {
      if (!visible.has(demo) || !autoplay.has(demo)) continue;
      autoplay.get(demo)!();
      break;
    }
  };
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const demo = entry.target.closest<HTMLElement>('[data-demo]')!;
        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) visible.add(demo);
        else visible.delete(demo);
      }
      playVisible();
    },
    { threshold: 0.5 },
  );
  for (const demo of demos) {
    const button = demo.querySelector<HTMLButtonElement>('[data-motion-control]')!;
    const label = button.querySelector('[data-control-label]')!;
    const icon = button.querySelector('.control-icon')!;
    const status = demo.querySelector('.demo-status')!;
    const update = (state: string) => {
      if (state === 'playing') {
        for (const other of demos) {
          if (other !== demo && other.dataset.playback === 'playing')
            other.querySelector<HTMLButtonElement>('[data-motion-control]')!.click();
        }
      }
      demo.dataset.playback = state;
      demo.classList.toggle('demo-active', state === 'playing' || state === 'paused');
      label.textContent =
        button.dataset[
          state === 'playing'
            ? 'pause'
            : state === 'paused'
              ? 'resume'
              : state === 'done'
                ? 'replay'
                : 'play'
        ]!;
      icon.textContent = state === 'playing' ? '||' : '▷';
    };
    const stage = demo.querySelector<HTMLElement>('.demo-stage')!;
    const consumeAutoplay = () => {
      autoplay.delete(demo);
      observer.unobserve(stage);
    };
    const start = (automatic = false) => {
      pending.add(demo);
      status.textContent = '';
      update('idle');
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          pending.delete(demo);
          if (reduced.matches) return;
          // 자동 대기는 실제로 보일 때만 시작하며, 수동으로 시작한 다른 장면을 멈추지 않는다.
          if (automatic && (document.hidden || !visible.has(demo) || hasPlaying())) return;
          consumeAutoplay();
          update('playing');
        }),
      );
    };
    autoplay.set(demo, () => start(true));
    observer.observe(stage);
    button.hidden = false;
    button.addEventListener('click', () => {
      if (reduced.matches) return;
      consumeAutoplay();
      if (pending.has(demo)) return;
      const state = demo.dataset.playback;
      if (state === 'playing' || state === 'paused')
        update(state === 'playing' ? 'paused' : 'playing');
      else start();
    });
    demo.addEventListener('animationend', (event) => {
      if ((event as AnimationEvent).animationName !== 'demo-timing') return;
      update('done');
      status.textContent = button.dataset.finished!;
      playVisible();
    });
    reduced.addEventListener('change', () => update('idle'));
  }
  document.addEventListener('visibilitychange', playVisible);
  reduced.addEventListener('change', playVisible);
</script>

<style is:global>
