    color: var(--color-accent);
    font: 11px var(--font-mono);
  }
  .home-showcase .demo-copy h3 {
    margin: 0;
    font-size: clamp(23px, 2.5vw, 31px);
    line-height: 1.4;
    letter-spacing: -0.045em;
    word-break: keep-all;
    text-wrap: balance;
  }
  .home-showcase .demo-description {
    margin: 14px 0 0;
    color: var(--color-muted);
    font-size: 14px;
    word-break: keep-all;
  }
