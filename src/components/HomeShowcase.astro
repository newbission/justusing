    display: grid;
  }
  .home-showcase .feature-demo {
    display: grid;
    grid-template-columns: 0.85fr 1.55fr;
    grid-template-rows: 1fr auto;
    gap: 0 36px;
    padding: 36px 0;
    border-top: 1px solid var(--color-line);
