    grid-column: 2;
    grid-row: 1 / 3;
    min-width: 0;
  }
  .home-showcase .demo-stage {
    position: relative;
    aspect-ratio: 1.5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-accent-soft);
  }
  .home-showcase .scene-labels {
    position: absolute;
    inset: 20px 22px auto;
    display: flex;
