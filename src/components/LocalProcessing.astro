---
/**
 * 홈의 움직이는 설명 그림: 고른 파일이 브라우저 안에서 처리되어 결과로 나오고, 서버로 가는 길은 끊겨 있다.
 *
 * - 움직임은 한 번(약 4초)만 하고 완성 그림에서 멈춘다. 화면에 보일 때 시작하고 '다시 보기'로 다시 본다.
 *   계속 반복하지 않는다 (번쩍임·산만함, WCAG 2.2.2).
 * - 기본 모양이 완성 그림이다. 스크립트가 없거나 움직임 줄이기(prefers-reduced-motion)를 켠 사람은 그대로 본다.
 *   스크립트가 `armed`를 붙여야 첫 장면(빈 자리)에서 멈춰 기다리고, `playing`을 붙이면 움직인다.
 * - opacity·transform만 움직여 레이아웃이 밀리지 않는다 (CLS 0). 광고 칸 가까이에 두지 않는다 (홈: 약속 카드 아래).
 * - 실제 동작과 어긋나는 그림을 그리지 않는다 (/safety/ 문구와 맞춘다: 서버는 파일을 받지 않는다).
 * - 도구 칸 격리까지 담은 자세한 네 장면짜리 그림(SafetyMotion)은 /safety/에 있고, 여기서 링크한다.
 * 그림은 꾸밈이고(aria-hidden), 같은 내용을 아래 글(figcaption)로 적는다.
 */
import { localeOf, localizePath } from '../i18n/locales';
import { ui } from '../i18n/ui';

const locale = localeOf(Astro.url.pathname);
const t = ui(locale).motion;

/** 종이 모양 (오른쪽 위 귀퉁이가 접힌 네모). x, y에서 w×h */
function paper(x: number, y: number, w: number, h: number): string {
  const fold = 7;
  return `M${x} ${y}H${x + w - fold}L${x + w} ${y + fold}V${y + h}H${x}Z`;
}
/** 종이 위 글 줄 */
function lines(x: number, y: number, widths: number[]): string {
  return widths.map((w, i) => `M${x} ${y + i * 5}h${w}`).join('');
}
---

<figure class="local-motion" data-local-motion>
  <div class="art" aria-hidden="true">
    <div class="stage">
      <div class="device">
        <div class="bar">
          <i></i>
          <i></i>
          <i></i>
          <span>{t.browser}</span>
        </div>
        <div class="steps">
          <div class="step s1">
            <svg viewBox="0 0 56 56" class="pic">
              <g class="pb">
                <path d={paper(20, 6, 28, 36)} class="sheet" />
                <path d={lines(25, 17, [16, 18, 12])} class="ink" />
              </g>
              <g class="pa">
                <path d={paper(8, 14, 28, 36)} class="sheet" />
                <path d={lines(13, 25, [16, 18, 12])} class="ink" />
              </g>
            </svg>
            <span>{t.myFiles}</span>
          </div>

          <div class="link l1">
            <svg viewBox="0 0 40 12" preserveAspectRatio="none">
              <path d="M2 6h34" pathLength="1" class="line" />
              <path d="M31 1.5l5 4.5-5 4.5" class="head" />
            </svg>
          </div>

          <div class="step s2">
            <svg viewBox="0 0 56 56" class="pic">
              <circle cx="28" cy="28" r="24" class="track" />
              <circle cx="28" cy="28" r="24" pathLength="1" class="ring" />
              <g class="ma">
                <path d={paper(20.5, 18.5, 15, 19)} class="sheet mini" />
              </g>
              <g class="mb">
                <path d={paper(20.5, 18.5, 15, 19)} class="sheet mini" />
              </g>
            </svg>
            <span>{t.processing}</span>
          </div>

          <div class="link l2">
            <svg viewBox="0 0 40 12" preserveAspectRatio="none">
              <path d="M2 6h34" pathLength="1" class="line" />
              <path d="M31 1.5l5 4.5-5 4.5" class="head" />
            </svg>
          </div>

          <div class="step s3">
            <svg viewBox="0 0 56 56" class="pic">
              <path d={paper(14, 3, 28, 34)} class="sheet result" />
              <path d={lines(19, 13, [16, 18, 12])} class="ink" />
              <path d="M28 40v10M23.5 45.5 28 50l4.5-4.5M17 53h22" class="save" />
            </svg>
            <span>{t.saved}</span>
          </div>
        </div>
      </div>

      <div class="cut">
        <svg viewBox="0 0 64 16" class="cut-line">
          <path d="M0 8h22M42 8h22" class="dash" />
          <g class="x">
            <path d="M27 3l10 10M37 3 27 13" />
          </g>
        </svg>
        <span>{t.noTransfer}</span>
      </div>

      <div class="server">
        <svg viewBox="0 0 24 24" class="icon">
          <path d="M4 4h16v6H4zM4 14h16v6H4zM8 7h.01M8 17h.01" />
        </svg>
        <span>{t.server}</span>
        <small>{t.serverNote}</small>
      </div>
    </div>
  </div>
  <figcaption>
    <div>
      <strong>{t.title}</strong>
      <p>{t.text}</p>
      <!-- 자세한 네 장면짜리 그림은 /safety/에 (홈은 짧게 둔다) -->
      <a class="more" href={`${localizePath('/safety/', locale)}#how-it-works`}>
        {t.more} →
      </a>
    </div>
    <button type="button" class="replay" aria-label={t.replayLabel} data-replay>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 12a8 8 0 1 0 2.3-5.6M4 4v4h4" />
      </svg>
      {t.replay}
    </button>
  </figcaption>
</figure>

<script>
  /** 움직임 줄이기를 켠 사람은 완성 그림만 본다 (CSS도 같은 조건에서 움직임을 끈다) */
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const figure of document.querySelectorAll<HTMLElement>('[data-local-motion]')) {
    if (reduce.matches) continue;
    // 첫 장면에서 멈춰 둔다. 화면에 보이면 움직인다
    figure.classList.add('armed');

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        figure.classList.add('playing');
        observer.disconnect();
      },
      { threshold: 0.6 },
    );
    observer.observe(figure.querySelector('.art')!);

    figure.querySelector('[data-replay]')!.addEventListener('click', () => {
      observer.disconnect();
      // 애니메이션을 처음부터 다시 돌리려면 한 번 떼었다 붙여야 한다
      figure.classList.remove('armed', 'playing');
      void figure.offsetWidth;
      figure.classList.add('armed', 'playing');
    });
  }
</script>

<style>
  figure {
    margin: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
    overflow: hidden;
    /* 한글이 낱말 가운데에서 끊기지 않게 */
    word-break: keep-all;
    overflow-wrap: break-word;
  }
  .art {
    padding: 28px 24px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-bg);
    font-size: 13px;
  }
  figcaption {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px 24px;
  }
  figcaption strong {
    display: block;
    font-size: 18px;
  }
  figcaption p {
    margin: 6px 0 0;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .more {
    display: inline-block;
    margin-top: 8px;
    color: var(--color-accent);
    font-size: 14px;
  }

  /* 다시 보기: 스크립트가 움직임을 준비했을 때만 보인다. 자리는 늘 차지해 글이 밀리지 않는다 */
  .replay {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    visibility: hidden;
  }
  .replay:hover {
    background: var(--color-hover);
  }
  .replay svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .armed .replay {
    visibility: visible;
  }

  svg {
    overflow: visible;
  }
  .stage {
    display: flex;
    align-items: center;
  }

  /* 내 기기의 브라우저 창 */
  .device {
    flex: 1 1 auto;
    min-width: 0;
    border: 2px solid var(--color-accent);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-accent);
    font-size: 12px;
    font-weight: 600;
  }
  .bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-line);
  }
  .bar span {
    margin-left: 6px;
  }
  .steps {
    display: flex;
    align-items: flex-start;
    gap: 4px;
    padding: 20px 12px;
  }
  .step {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    min-width: 0;
    text-align: center;
    font-weight: 600;
  }
  .pic {
    width: 56px;
    height: 56px;
  }
  .sheet {
    fill: var(--color-paper);
    stroke: var(--color-muted);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  .sheet.result,
  .sheet.mini {
    stroke: var(--color-accent);
    stroke-width: 1.8;
  }
  .ink {
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .track,
  .ring {
    fill: none;
    stroke-width: 3;
  }
  .track {
    stroke: var(--color-line);
  }
  .ring {
    stroke: var(--color-accent);
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transform: rotate(-90deg);
    transform-origin: 28px 28px;
  }
  .save {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 단계 사이 화살표 */
  .link {
    flex: 0 0 40px;
    padding-top: 22px;
    color: var(--color-accent);
  }
  .link svg {
    display: block;
    width: 100%;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .link .line {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  /* 서버로 가는 끊긴 길 */
  .cut {
    display: flex;
    flex: 0 0 96px;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 0 6px;
    color: var(--color-accent);
    font-size: 12px;
    font-weight: 600;
    text-align: center;
  }
  .cut-line {
    width: 64px;
    height: 16px;
    fill: none;
    stroke-linecap: round;
  }
  .cut-line .dash {
    stroke: var(--color-muted);
    stroke-width: 1.6;
    stroke-dasharray: 3 4;
  }
  .cut-line .x {
    stroke: currentColor;
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
  }
  .server {
    display: flex;
    flex: 0 0 112px;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 12px 8px;
    border: 1px dashed var(--color-muted);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-muted);
    text-align: center;
    font-weight: 600;
  }
  .server small {
    font-size: 12px;
    font-weight: 400;
  }
  .icon {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /*
   * 움직임. 기본 모양이 마지막 장면이고, 아래 keyframes의 from이 첫 장면이다.
   * armed: 첫 장면에서 멈춤(fill-mode both + paused), playing: 움직임.
   * 차례: 내 파일(0s) → 화살표 → 처리(원이 차며 두 장이 하나로) → 화살표 → 결과 저장 → 끊긴 길 강조(~4.2s)
   */
  .armed .pa,
  .armed .pb,
  .armed .s1 span,
  .armed .line,
  .armed .head,
  .armed .s2,
  .armed .ring,
  .armed .ma,
  .armed .mb,
  .armed .s3,
  .armed .x {
    animation-duration: 0.5s;
    animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
    animation-fill-mode: both;
    animation-play-state: paused;
  }
  .playing .pa,
  .playing .pb,
  .playing .s1 span,
  .playing .line,
  .playing .head,
  .playing .s2,
  .playing .ring,
  .playing .ma,
  .playing .mb,
  .playing .s3,
  .playing .x {
    animation-play-state: running;
  }

  .armed .pb {
    animation-name: slide-in;
  }
  .armed .pa {
    animation-name: slide-in;
    animation-delay: 0.15s;
  }
  .armed .s1 span {
    animation-name: fade-in;
    animation-delay: 0.1s;
  }
  .armed .l1 .line {
    animation-name: draw;
    animation-duration: 0.4s;
    animation-delay: 0.7s;
  }
  .armed .l1 .head {
    animation-name: fade-in;
    animation-duration: 0.2s;
    animation-delay: 1s;
  }
  .armed .s2 {
    animation-name: fade-in;
    animation-duration: 0.3s;
    animation-delay: 1.1s;
  }
  .armed .ring {
    animation-name: draw;
    animation-duration: 1.2s;
    animation-timing-function: ease-in-out;
    animation-delay: 1.3s;
  }
  .armed .ma {
    animation-name: merge-left;
    animation-duration: 0.6s;
    animation-timing-function: ease-in-out;
    animation-delay: 1.8s;
  }
  .armed .mb {
    animation-name: merge-right;
    animation-duration: 0.6s;
    animation-timing-function: ease-in-out;
    animation-delay: 1.8s;
  }
  .armed .l2 .line {
    animation-name: draw;
    animation-duration: 0.4s;
    animation-delay: 2.6s;
  }
  .armed .l2 .head {
    animation-name: fade-in;
    animation-duration: 0.2s;
    animation-delay: 2.9s;
  }
  .armed .s3 {
    animation-name: pop-in;
    animation-delay: 3.05s;
  }
  .armed .x {
    animation-name: nudge;
    animation-duration: 0.6s;
    animation-timing-function: ease-in-out;
    animation-delay: 3.6s;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  /* 내 파일: 위에서 브라우저 창 안으로 내려앉는다 */
  @keyframes slide-in {
    from {
      opacity: 0;
      transform: translate(-6px, -14px);
    }
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }
  /* 처리: 따로 있던 두 장이 가운데에서 한 장으로 겹친다 */
  @keyframes merge-left {
    from {
      transform: translateX(-7px);
    }
  }
  @keyframes merge-right {
    from {
      transform: translateX(7px);
    }
  }
  @keyframes pop-in {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
  }
  /* 끊긴 길의 ×를 한 번 살짝 키웠다 돌린다 */
  @keyframes nudge {
    50% {
      transform: scale(1.3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .local-motion * {
      animation: none !important;
    }
    /* 처음 그릴 때부터 정해지므로 빼도 레이아웃이 밀리지 않는다 */
    .replay {
      display: none;
    }
  }

  /* 휴대폰: 서버는 브라우저 창 아래로, 끊긴 길은 세로로 */
  @media (max-width: 719px) {
    .art {
      padding: 16px;
    }
    figcaption {
      flex-direction: column;
      gap: 12px;
      padding: 16px;
    }
    figcaption strong {
      font-size: 16px;
    }
    .stage {
      flex-direction: column;
      align-items: stretch;
    }
    .steps {
      padding: 16px 8px;
    }
    .step {
      font-size: 12px;
    }
    .link {
      flex-basis: 24px;
    }
    .cut {
      flex: none;
      flex-direction: row;
      position: relative;
      justify-content: center;
      height: 64px;
      padding: 0;
    }
    /* 끊긴 길은 가운데, 글은 그 오른쪽에 */
    .cut-line {
      width: 56px;
      height: 14px;
      transform: rotate(90deg);
    }
    .cut span {
      position: absolute;
      top: 50%;
      left: calc(50% + 16px);
      transform: translateY(-50%);
    }
    .server {
      flex: none;
      flex-direction: row;
      justify-content: center;
      gap: 8px;
      padding: 10px 12px;
    }
  }
</style>
