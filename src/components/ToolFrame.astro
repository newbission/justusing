---
/**
 * 도구 화면을 격리된 iframe으로 띄운다.
 *
 * sandbox="allow-scripts allow-downloads" (allow-same-origin 없음):
 *   frame은 출처가 없는 상태가 되어 바깥 페이지의 스크립트(광고·통계)가 안쪽 내용에
 *   접근할 수 없고, 안쪽도 바깥이나 사이트 저장소에 접근할 수 없다.
 *
 * 개발 서버(npm run dev)는 출처 없는 frame의 요청을 막기 때문에 개발 중에만 격리를 끈다.
 * 격리 상태는 빌드 결과로 도는 E2E 테스트에서 확인한다.
 *
 * allow="fullscreen": 도구가 스스로 전체 화면으로 볼 수 있게 한다 (PDF 보기의 전체 화면 버튼).
 *   격리(sandbox)와는 별개라 바깥 페이지 접근은 여전히 막혀 있다.
 *
 * 높이는 고정이다. frame 안에서 스크롤하므로 처리 전후로 바깥 레이아웃(광고 위치)이 밀리지 않는다.
 *
 * 파일을 끌고 페이지에 들어오면 iframe을 잠시 화면 전체로 넓힌다. 사용자가 어디에 놓든
 * 파일이 바깥 페이지가 아니라 격리 frame 안으로 들어가게 하기 위함이다.
 * (끄는 동안 바깥 페이지가 아는 것은 '파일을 끌고 있다'는 사실뿐이고 내용은 알 수 없다)
 *
 * frame과 주고받는 메시지 (내용 없이 신호만):
 *   바깥 → frame: { type: 'theme', theme }, { type: 'drag-start', width, height }
 *   frame → 바깥: { type: 'drag-request' }(도구 칸 안에서 끌기 시작), { type: 'drag-ready' },
 *                 { type: 'drag-end' }, { type: 'show-tool' }(도구 칸이 화면을 채우도록 스크롤)
 */
interface Props {
  /** frame 페이지 주소 (예: /pdf/view/frame/) */
  src: string;
  /** 스크린리더가 읽는 frame 이름 */
  title: string;
}

const { src, title } = Astro.props;
const sandbox = import.meta.env.DEV ? undefined : 'allow-scripts allow-downloads';
---

<div class="tool-frame-box">
  <iframe
    class="tool-frame"
    data-tool-frame
    data-src={src}
    title={title}
    sandbox={sandbox}
    allow="fullscreen"
  ></iframe>
</div>
<noscript>
  <p class="noscript">이 도구는 JavaScript가 켜져 있어야 동작합니다.</p>
</noscript>

<script>
  // 저장된 테마를 주소(#theme=)로 넘겨 처음부터 같은 테마로 그리고,
  // 테마를 바꾸면 메시지로 알린다. frame은 출처가 없어 대상 출처를 '*'로 보낸다(테마 값만 담김).
  for (const frame of document.querySelectorAll<HTMLIFrameElement>('[data-tool-frame]')) {
    const theme = document.documentElement.dataset.theme;
    frame.src = frame.dataset.src + (theme ? `#theme=${theme}` : '');

    document.addEventListener('themechange', (event) => {
      const detail = (event as CustomEvent<string>).detail;
      frame.contentWindow?.postMessage({ type: 'theme', theme: detail }, '*');
    });

    // 파일을 끌고 들어오면 frame을 화면 전체로 넓힌다.
    // 순서: frame에 알림(지금 크기 전달) → frame이 덮개를 덮고 도구 화면 크기를 고정한 뒤 응답
    //       → 그때 넓힌다. 그래서 넓어지는 동안 도구 화면이 늘어나 보이지 않는다.
    let waiting = false;
    let readyTimer: ReturnType<typeof setTimeout> | undefined;
    const collapse = () => {
      waiting = false;
      clearTimeout(readyTimer);
      frame.removeAttribute('data-drag-active');
    };
    const expand = () => {
      waiting = false;
      clearTimeout(readyTimer);
      frame.setAttribute('data-drag-active', '');
    };
    const start = () => {
      if (waiting || frame.hasAttribute('data-drag-active')) return;
      waiting = true;
      frame.contentWindow?.postMessage(
        { type: 'drag-start', width: frame.clientWidth, height: frame.clientHeight },
        '*',
      );
      // frame이 아직 준비되지 않아 응답이 없으면 넓히지 않는다 (바깥에 놓여도 DropGuard가 막는다)
      readyTimer = setTimeout(() => (waiting = false), 500);
    };

    addEventListener('dragenter', (event) => {
      if (event.dataTransfer?.types.includes('Files')) start();
    });
    addEventListener('message', (event) => {
      if (event.source !== frame.contentWindow) return;
      // drag-request: 도구 칸 안에서 시작된 끌기 (frame은 이미 덮개를 덮고 고정한 상태)
      if (event.data?.type === 'drag-ready' || event.data?.type === 'drag-request') expand();
      if (event.data?.type === 'drag-end') collapse();
      // 파일을 열면 도구 칸 위쪽을 화면 위쪽(16px 여백)에 맞춰 칸이 화면을 꽉 채우게 한다.
      // 부드럽게 움직이면 그동안 버튼이 손 아래에서 움직여 엉뚱한 것을 누를 수 있어 바로 옮긴다.
      if (event.data?.type === 'show-tool') {
        scrollTo({ top: frame.getBoundingClientRect().top + scrollY - 16, behavior: 'instant' });
      }
    });
  }
</script>

<style>
  /* 높이는 바깥 상자가 잡는다. iframe이 잠시 화면 전체로 넓어져도 이 자리는 그대로다.
     화면 높이에서 위아래 여백(16px씩)만 뺀 크기라, 도구 칸까지 스크롤하면 화면을 꽉 채운다. */
  .tool-frame-box {
    height: clamp(520px, calc(100svh - 32px), 1400px);
  }
  /* 모바일 하단 고정 광고가 있으면 그만큼 더 줄여 칸 아래쪽이 가려지지 않게 한다
     (1px = 광고 위 테두리, 28px = 접기 탭. MobileAnchor의 하단 여백 계산과 같다) */
  @media (max-width: 767px) {
    :global(body:has(.mobile-anchor .ad-slot)) .tool-frame-box {
      height: clamp(
        440px,
        calc(100svh - 32px - var(--ad-mobile-anchor-h) - 1px - 28px - env(safe-area-inset-bottom)),
        1400px
      );
    }
  }
  .tool-frame {
    display: block;
    width: 100%;
    height: 100%;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  /* 파일을 끄는 동안: 화면 전체를 덮어 어디에 놓든 frame이 받는다 (떠 있는 상태라 레이아웃은 그대로) */
  .tool-frame[data-drag-active] {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    border: 0;
    border-radius: 0;
  }
  .noscript {
    color: var(--color-muted);
  }
</style>
