---
/**
 * 도구 화면을 격리된 iframe으로 띄운다.
 *
 * sandbox="allow-scripts allow-downloads" (allow-same-origin 없음):
 *   frame은 출처가 없는 상태가 되어 바깥 페이지의 스크립트(광고·통계)가 안쪽 내용에
 *   접근할 수 없고, 안쪽도 바깥이나 사이트 저장소에 접근할 수 없다.
 *
 * 개발 서버(npm run dev)는 출처 없는 frame의 요청을 막기 때문에 개발 중에만 격리를 끈다.
 * 격리 상태는 빌드 결과로 도는 E2E 테스트에서 확인한다.
 *
 * 높이는 고정이다. frame 안에서 스크롤하므로 처리 전후로 바깥 레이아웃(광고 위치)이 밀리지 않는다.
 */
interface Props {
  /** frame 페이지 주소 (예: /pdf/view/frame/) */
  src: string;
  /** 스크린리더가 읽는 frame 이름 */
  title: string;
}

const { src, title } = Astro.props;
const sandbox = import.meta.env.DEV ? undefined : 'allow-scripts allow-downloads';
---

<iframe class="tool-frame" data-tool-frame data-src={src} title={title} sandbox={sandbox}></iframe>
<noscript>
  <p class="noscript">이 도구는 JavaScript가 켜져 있어야 동작합니다.</p>
</noscript>

<script>
  // 저장된 테마를 주소(#theme=)로 넘겨 처음부터 같은 테마로 그리고,
  // 테마를 바꾸면 메시지로 알린다. frame은 출처가 없어 대상 출처를 '*'로 보낸다(테마 값만 담김).
  for (const frame of document.querySelectorAll<HTMLIFrameElement>('[data-tool-frame]')) {
    const theme = document.documentElement.dataset.theme;
    frame.src = frame.dataset.src + (theme ? `#theme=${theme}` : '');

    document.addEventListener('themechange', (event) => {
      const detail = (event as CustomEvent<string>).detail;
      frame.contentWindow?.postMessage({ type: 'theme', theme: detail }, '*');
    });
  }
</script>

<style>
  .tool-frame {
    display: block;
    width: 100%;
    height: clamp(520px, 80svh, 900px);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .noscript {
    color: var(--color-muted);
  }
</style>
