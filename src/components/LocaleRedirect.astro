---
/**
 * 처음 온 방문자를 브라우저 언어에 맞는 언어판으로 보낸다. <head> 맨 앞쪽에서 실행해 화면이 깜빡이지 않게 한다.
 *
 * - 직접 고른 언어(LocaleSwitch가 저장)가 있으면 그 언어를 따른다.
 * - 없으면 브라우저의 첫 번째 언어를 보고, 지원하지 않는 언어면 영어로 보낸다.
 * - 검색 로봇과 자동화 브라우저는 보내지 않는다. 구글 로봇은 영어 브라우저로 오기 때문에, 보내면
 *   한국어 페이지를 읽지 못하고 한국어 검색에서 빠진다. 각 언어판은 hreflang으로 알린다 (BaseLayout).
 * - 바깥 페이지에서만 쓴다. 도구 frame은 바깥 주소를 따라 언어가 정해진다.
 */
import {
  LOCALE_STORAGE_KEY,
  LOCALES,
  localeOf,
  localizePath,
  withoutLocale,
} from '../i18n/locales';

/** 브라우저 언어가 지원 목록에 없을 때 보낼 언어 */
const FALLBACK_LOCALE = 'en';

const current = localeOf(Astro.url.pathname);
const path = withoutLocale(Astro.url.pathname);
const targets = Object.fromEntries(LOCALES.map((locale) => [locale, localizePath(path, locale)]));
---

<script
  is:inline
  define:vars={{
    key: LOCALE_STORAGE_KEY,
    locales: LOCALES,
    current,
    targets,
    fallback: FALLBACK_LOCALE,
  }}
>
  (() => {
    const agent = navigator.userAgent;
    if (navigator.webdriver || /bot|crawl|spider|slurp|yeti|daum|bingpreview/i.test(agent)) return;

    let saved = null;
    try {
      saved = localStorage.getItem(key);
    } catch {
      // 저장소를 못 읽으면 브라우저 언어로 정한다
    }
    let wanted = locales.includes(saved) ? saved : null;
    if (!wanted) {
      const first = (navigator.languages?.[0] ?? navigator.language ?? '').toLowerCase();
      wanted =
        locales.find((locale) => first === locale || first.startsWith(`${locale}-`)) ?? fallback;
    }
    if (wanted !== current) location.replace(targets[wanted] + location.search + location.hash);
  })();
</script>
