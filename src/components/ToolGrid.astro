---
/**
 * 도구 카드 목록. 화면 폭에 따라 1~3열로 배치한다.
 */
import type { Tool } from '../tools/registry';
import ToolCard from './ToolCard.astro';

interface Props {
  tools: Tool[];
  headingLevel?: 2 | 3;
}

const { tools, headingLevel } = Astro.props;
---

<ul class="grid">
  {tools.map((tool) => (
    <li>
      <ToolCard tool={tool} headingLevel={headingLevel} />
    </li>
  ))}
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
