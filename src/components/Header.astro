---
import { siteConfig } from '../site.config';
import { CATEGORIES } from '../tools/categories';
import { visibleCategories } from '../tools/registry';
import ThemeToggle from './ThemeToggle.astro';
import LocaleSwitch from './LocaleSwitch.astro';
import Logo from './Logo.astro';
import { localeOf, localizePath } from '../i18n/locales';
import { ui } from '../i18n/ui';

const currentPath = Astro.url.pathname;
const locale = localeOf(currentPath);
const t = ui(locale);
// 도구 분류들, 그리고 맨 뒤에 가이드
const links = [
  ...visibleCategories.map((category) => ({
    href: localizePath(`/${category}/`, locale),
    name: CATEGORIES[category].text[locale].name,
  })),
  { href: localizePath('/guide/', locale), name: t.nav.guides },
];
---

<header class="site-header">
  <div class="inner">
    <a class="logo" href={localizePath('/', locale)} aria-label={siteConfig.name}>
      <Logo />
    </a>
    <nav class="nav" aria-label={t.nav.categories}>
      <ul>
        {links.map(({ href, name }) => (
          <li>
            <a href={href} aria-current={currentPath.startsWith(href) ? 'page' : undefined}>
              {name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="actions">
      <LocaleSwitch />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-line);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: var(--content-max);
    height: 56px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .logo {
    flex: none;
  }
  .actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: 8px;
  }
  .nav {
    flex: 1;
    min-width: 0;
  }
  /* 메뉴가 넘치면 옆으로 밀어 본다 (좁은 화면에서 언어 버튼과 겹치지 않게) */
  .nav {
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav ul {
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    white-space: nowrap;
  }
  .nav a {
    color: var(--color-muted);
    font-size: 15px;
    text-decoration: none;
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--color-text);
  }
  @media (max-width: 480px) {
    .inner {
      gap: 14px;
    }
    .nav ul {
      gap: 12px;
    }
    .nav a {
      font-size: 14px;
    }
  }
</style>
