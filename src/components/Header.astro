---
import { siteConfig } from '../site.config';
import { CATEGORIES } from '../tools/categories';
import { visibleCategories } from '../tools/registry';
import ThemeToggle from './ThemeToggle.astro';
import LocaleSwitch from './LocaleSwitch.astro';
import Logo from './Logo.astro';
import { localeOf, localizePath } from '../i18n/locales';
import { ui } from '../i18n/ui';

const currentPath = Astro.url.pathname;
const locale = localeOf(currentPath);
const t = ui(locale);
---

<header class="site-header">
  <div class="inner">
    <a class="logo" href={localizePath('/', locale)} aria-label={siteConfig.name}>
      <Logo />
    </a>
    <nav class="nav" aria-label={t.nav.categories}>
      <ul>
        {visibleCategories.map((category) => {
          const href = localizePath(`/${category}/`, locale);
          return (
            <li>
              <a href={href} aria-current={currentPath.startsWith(href) ? 'page' : undefined}>
                {CATEGORIES[category].text[locale].name}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
    <div class="actions">
      <LocaleSwitch />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-line);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: var(--content-max);
    height: 56px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .logo {
    flex: none;
  }
  .actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: 8px;
  }
  .nav {
    flex: 1;
    min-width: 0;
  }
  .nav ul {
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav a {
    color: var(--color-muted);
    font-size: 15px;
    text-decoration: none;
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--color-text);
  }
</style>
