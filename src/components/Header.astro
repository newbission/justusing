---
import { siteConfig } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';
import LocaleSwitch from './LocaleSwitch.astro';
import Logo from './Logo.astro';
import MegaMenu from './MegaMenu.astro';
import { siteMenus } from './site-menu';
import { localeOf, localizePath } from '../i18n/locales';
import { ui } from '../i18n/ui';

const locale = localeOf(Astro.url.pathname);
const t = ui(locale);
// 도구 분류들, 그리고 맨 뒤에 가이드
const menus = siteMenus(Astro.url.pathname);
---

<header class="site-header">
  <div class="inner">
    <a class="logo" href={localizePath('/', locale)} aria-label={siteConfig.name}>
      <Logo />
    </a>
    <div class="nav">
      <MegaMenu {menus} label={t.nav.categories} />
    </div>
    <div class="actions">
      <LocaleSwitch />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  /* 펼침 메뉴의 판이 머리글 폭 전체에 걸리게 기준을 잡는다 */
  .site-header {
    position: relative;
    border-bottom: 1px solid var(--color-line);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: var(--content-max);
    height: 56px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .logo {
    flex: none;
  }
  .actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: 8px;
  }
  .nav {
    flex: 1;
    align-self: stretch;
    min-width: 0;
  }
  @media (max-width: 767px) {
    .inner {
      gap: 14px;
    }
  }
</style>
