---
/**
 * '안전한 이유' 움직이는 그림의 한 장면 (SafetyMotion이 장면마다 하나씩 그린다).
 *
 * 모든 장면이 같은 무대를 쓴다: 브라우저 창(바깥 페이지: 광고·방문 통계, 그 안의 도구 칸)과
 * 창 밖의 세 곳(다운로드 폴더, 이 사이트, 다른 사이트). 장면마다 그 위에 움직임을 얹는다.
 *
 * - 기본 모양이 그 장면의 마지막 그림이다. 부모가 `run`을 붙이면 처음부터 움직이고(fill-mode both),
 *   `paused`를 붙이면 멈춘다. 움직임 줄이기를 켜면 움직이지 않고 마지막 그림만 보인다.
 * - opacity·transform·stroke만 바꾼다. 그림 크기는 viewBox로 정해져 레이아웃이 밀리지 않는다.
 * - 실제 구현과 맞춘다: ToolFrame(sandbox, 끌 때 화면 전체로 넓힘), DropGuard, FrameLayout(CSP),
 *   createWorker(이 사이트에서 받은 프로그램으로 워커), download.ts(blob 다운로드).
 * 그림은 꾸밈이고(aria-hidden은 부모가 단다), 같은 내용을 장면 글로 적는다.
 */
import { localeOf } from '../i18n/locales';
import { ui } from '../i18n/ui';
import { siteConfig } from '../site.config';

interface Props {
  scene: 1 | 2 | 3 | 4;
}

const { scene } = Astro.props;
const t = ui(localeOf(Astro.url.pathname)).safetyMotion;

/** 종이 모양 (오른쪽 위 귀퉁이가 접힌 네모). x, y에서 w×h */
function paper(x: number, y: number, w: number, h: number): string {
  const fold = Math.round(w / 4);
  return `M${x} ${y}H${x + w - fold}L${x + w} ${y + fold}V${y + h}H${x}Z`;
}
/** 종이 위 글 줄 */
function lines(x: number, y: number, widths: number[], gap = 5): string {
  return widths.map((w, i) => `M${x} ${y + i * gap}h${w}`).join('');
}

/** 24×24 칸에 선으로 그린 아이콘 */
const icon = {
  lock: 'M6 11h12v9H6zM8.5 11V8a3.5 3.5 0 0 1 7 0v3',
  folder:
    'M3 6.5A1.5 1.5 0 0 1 4.5 5H9l2 2h8.5A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5z',
  server: 'M4 4h16v6H4zM4 14h16v6H4zM8 7h.01M8 17h.01',
  globe:
    'M12 3a9 9 0 1 0 0 18 9 9 0 1 0 0-18M3 12h18M12 3c2.4 2.5 3.5 5.5 3.5 9s-1.1 6.5-3.5 9c-2.4-2.5-3.5-5.5-3.5-9s1.1-6.5 3.5-9',
  gear: 'M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 1 0 0-7M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1',
  eye: 'M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6S2 12 2 12zM12 9.6a2.4 2.4 0 1 0 0 4.8 2.4 2.4 0 1 0 0-4.8',
};
/** 화살표 마우스 커서 (끝이 0,0) */
const cursor = 'M0 0V15.5L4.1 11.8 6.9 18.2 9.5 17.1 6.8 10.9H12.2Z';
/** ✕ 표시 (가운데 0,0) */
const cross = 'M-2.6-2.6l5.2 5.2M2.6-2.6l-5.2 5.2';

/*
 * 무대 좌표 (viewBox 360×356)
 * 브라우저 창 4,4 ~ 356,240 · 광고 16,38 ~ 216,62 · 방문 통계 226,38 ~ 344,62 · 도구 칸 16,98 ~ 344,222
 * 창 밖 세 곳(y 272 ~ 344): 다운로드 폴더 가운데 x 59, 이 사이트 180, 다른 사이트 301
 */
const nodes = [
  { key: 'downloads', cx: 59, icon: icon.folder, name: t.downloads, sub: t.myDevice },
  { key: 'site', cx: 180, icon: icon.server, name: siteConfig.domain, sub: t.thisSite },
  { key: 'other', cx: 301, icon: icon.globe, name: t.otherSites, sub: t.internet },
] as const;
/** 장면마다 창 밖 세 곳의 모양: on(이번 장면의 주인공), dim(흐리게), 없으면 보통 */
const nodeState: Record<number, Partial<Record<(typeof nodes)[number]['key'], 'on' | 'dim'>>> = {
  1: { downloads: 'dim', site: 'dim', other: 'dim' },
  2: { downloads: 'dim', site: 'on' },
  3: { downloads: 'dim', site: 'on', other: 'dim' },
  4: { downloads: 'on', site: 'dim', other: 'dim' },
};

/*
 * 장면 1·2: 광고·방문 통계 스크립트가 파일 쪽으로 손을 뻗다가 도구 칸 벽(y 98)에 막힌다.
 * from: 출발점, hit: 벽에 닿는 점, eye: 눈이 멈추는 자리(벽에서 16만큼 물러남),
 * start·touch: 눈의 출발·접촉 위치(eye 기준 상대값)
 */
const probes = [
  {
    from: [120, 62],
    hit: [144.5, 98],
    eye: [135.5, 84.8],
    start: [-15.5, -22.8],
    touch: [4.5, 6.6],
  },
  { from: [285, 62], hit: [242, 98], eye: [254.3, 87.7], start: [30.7, -25.7], touch: [-6.1, 5.1] },
];
---

<svg
  viewBox="0 0 360 356"
  class:list={['stage', `s${scene}`]}
  xmlns="http://www.w3.org/2000/svg"
  focusable="false"
>
  <!-- 바깥 페이지 (브라우저 창) -->
  <g class="window">
    <rect x="4" y="4" width="352" height="236" rx="10" class="win" />
    <path d="M4 28H356" class="win-line" />
    <circle cx="16" cy="16" r="3" class="dot" />
    <circle cx="27" cy="16" r="3" class="dot" />
    <circle cx="38" cy="16" r="3" class="dot" />
    <text x="50" y="19.5" class="t-url">
      {siteConfig.domain}
    </text>
    <text x="344" y="19.5" text-anchor="end" class="t-tag">
      {t.outerPage}
    </text>
    <g class="scripts">
      <rect x="16" y="38" width="200" height="24" rx="5" class="ad" />
      <text x="116" y="54" text-anchor="middle" class="t-muted">
        {t.ad}
      </text>
      <rect x="226" y="38" width="118" height="24" rx="12" class="stats" />
      <text x="285" y="54" text-anchor="middle" class="t-muted">
        {t.analytics}
      </text>
    </g>
  </g>

  <!-- 도구 칸 (격리된 iframe) -->
  <g class="frame">
    <rect x="16" y="98" width="328" height="124" rx="8" class="tool" />
    <g transform="translate(26 103.5) scale(0.5)">
      <path d={icon.lock} class="ico ico-accent" />
    </g>
    <text x="43" y="114" class="t-frame">
      {t.toolArea}
    </text>
  </g>

  <!-- 창 밖: 다운로드 폴더 · 이 사이트 · 다른 사이트 -->
  {nodes.map((node) => (
    <g class:list={['node', `node-${node.key}`, nodeState[scene][node.key]]}>
      <rect x={node.cx - 55} y="272" width="110" height="72" rx="8" class="node-box" />
      <g transform={`translate(${node.cx - 12} 279)`}>
        <path d={node.icon} class="ico node-ico" />
      </g>
      <text x={node.cx} y="320" text-anchor="middle" class="t-node">
        {node.name}
      </text>
      <text x={node.cx} y="335" text-anchor="middle" class="t-sub">
        {node.sub}
      </text>
    </g>
  ))}

  {(scene === 1 || scene === 2) && (
    <g class="probes">
      {probes.map((p, i) => (
        <g class={`probe probe-${i + 1}`}>
          <path
            d={`M${p.from[0]} ${p.from[1]}L${p.hit[0]} ${p.hit[1]}`}
            pathLength="1"
            class="ray"
          />
          <g transform={`translate(${p.hit[0]} ${p.hit[1]})`}>
            <circle r="5" class="ripple" />
          </g>
          <g transform={`translate(${p.eye[0]} ${p.eye[1]})`}>
            <g class="eye">
              <circle r="8" class="eye-bg" />
              <g transform="translate(-6.6 -6.6) scale(0.55)">
                <path d={icon.eye} class="ico" />
              </g>
            </g>
          </g>
          <g transform={`translate(${p.hit[0]} ${p.hit[1]})`}>
            <g class="hit">
              <circle r="6.5" class="hit-bg" />
              <path d={cross} class="hit-x" />
            </g>
          </g>
        </g>
      ))}
    </g>
  )}

  {scene === 1 && (
    <g class="file">
      <path d={paper(166, 132, 28, 36)} class="sheet" />
      <path d={lines(171, 146, [15, 17, 11])} class="ink" />
      <text x="180" y="186" text-anchor="middle" class="t-label">
        {t.myFile}
      </text>
    </g>
  )}

  {scene === 2 && (
    <g class="rules">
      <g class="code1">
        <text x="28" y="140" class="t-code">
          {['<iframe ', <tspan class="hl">sandbox="allow-scripts allow-downloads"</tspan>, '>']}
        </text>
      </g>
      <text x="28" y="156" class="t-note note1">
        {t.noOrigin}
      </text>
      <g class="code2">
        <text x="28" y="186" class="t-code">
          {[<tspan class="hl">default-src 'none'</tspan>, "; connect-src 'self'"]}
        </text>
      </g>
      <text x="28" y="202" class="t-note note2">
        {t.onlyOurFiles}
      </text>

      <!-- 다른 사이트로 연결하려다 막힘 -->
      <g class="out">
        <path d="M301 222V240" pathLength="1" class="ray" />
        <path d="M301 254V270" class="dash" />
        <g transform="translate(301 247)">
          <g class="hit">
            <circle r="6.5" class="hit-bg" />
            <path d={cross} class="hit-x" />
          </g>
        </g>
        <text x="291" y="251" text-anchor="end" class="t-small out-label">
          {t.blocked}
        </text>
      </g>
      <!-- 이 사이트의 파일만 들어온다 -->
      <g class="in">
        <path d="M166 270V225" pathLength="1" class="flow" />
        <path d="M161.5 229.5 166 225l4.5 4.5" class="flow-head" />
        <text x="156" y="251" text-anchor="end" class="t-small t-accent in-label">
          {t.ourFilesOnly}
        </text>
      </g>
    </g>
  )}

  {scene === 3 && (
    <g class="process">
      <!-- 처리 프로그램은 이 사이트에서 받는다 -->
      <g class="in">
        <path d="M166 270V225" pathLength="1" class="flow" />
        <path d="M161.5 229.5 166 225l4.5 4.5" class="flow-head" />
        <text x="156" y="251" text-anchor="end" class="t-small t-accent in-label">
          {t.program}
        </text>
      </g>

      <g class="worker">
        <rect x="140" y="126" width="80" height="58" rx="8" class="worker-box" />
        <g transform="translate(165.6 133) scale(1.2)">
          <g class="gear">
            <path d={icon.gear} class="ico ico-accent" />
          </g>
        </g>
        <rect x="152" y="171" width="56" height="3" rx="1.5" class="track" />
        <rect x="152" y="171" width="56" height="3" rx="1.5" class="progress" />
        <text x="180" y="201" text-anchor="middle" class="t-label t-accent">
          {t.worker}
        </text>
      </g>

      <!-- 놓은 파일: 도구 칸 왼쪽에 자리 잡은 뒤 작업자에게 들어간다 -->
      <g class="settle">
        <g class="feed">
          <path d={paper(44, 140, 24, 30)} class="sheet" />
          <path d={lines(48.5, 152, [13, 15, 9], 4.5)} class="ink" />
        </g>
      </g>

      <g class="outfile">
        <path d={paper(280, 140, 24, 30)} class="sheet result" />
        <path d={lines(284.5, 152, [13, 15, 9], 4.5)} class="ink" />
      </g>

      <!-- 파일을 서버로 보내는 길은 없다 -->
      <g class="cut">
        <path d="M194 222V240M194 254V270" class="dash" />
        <g transform="translate(194 247)">
          <g class="hit">
            <circle r="6.5" class="hit-bg" />
            <path d={cross} class="hit-x" />
          </g>
        </g>
        <text x="204" y="251" class="t-small cut-label">
          {t.noUpload}
        </text>
      </g>

      <!-- 끄는 동안 도구 칸이 화면 전체로 넓어진다 (ToolFrame) -->
      <rect x="8" y="32" width="344" height="204" rx="8" class="overlay" />
      <g class="overlay-text">
        <text x="180" y="96" text-anchor="middle" class="t-drop">
          {t.dropHere}
        </text>
        <text x="180" y="114" text-anchor="middle" class="t-small">
          {t.frameFills}
        </text>
      </g>

      <g class="drag">
        <path d={paper(318, 68, 20, 26)} class="sheet" />
        <path d={lines(322, 78, [11, 12, 8], 4)} class="ink" />
        <g transform="translate(332 84)">
          <path d={cursor} class="cursor" />
        </g>
      </g>
    </g>
  )}

  {scene === 4 && (
    <g class="deliver">
      <path d={paper(166, 126, 28, 36)} class="sheet result" />
      <path d={lines(171, 140, [15, 17, 11])} class="ink" />
      <g class="button">
        <rect x="140" y="172" width="80" height="24" rx="12" class="btn" />
        <text x="180" y="188" text-anchor="middle" class="t-btn">
          {t.download}
        </text>
      </g>

      <!-- 내 기기로 곧장 -->
      <g class="save">
        <path d="M59 222V266" pathLength="1" class="flow" />
        <path d="M54.5 261.5 59 266l4.5-4.5" class="flow-head" />
        <text x="68" y="251" class="t-small t-accent save-label">
          {t.savedDirectly}
        </text>
      </g>
      <g transform="translate(108 278)">
        <g class="badge">
          <circle r="8" class="badge-bg" />
          <path d="M-3.5 0.2l2.3 2.3 4.7-4.8" class="badge-check" />
        </g>
      </g>

      <!-- 인터넷으로는 나가지 않는다 -->
      <g class="cut">
        <path d="M194 222V240M194 254V270M301 222V240M301 254V270" class="dash" />
        <g transform="translate(194 247)">
          <g class="hit">
            <circle r="6.5" class="hit-bg" />
            <path d={cross} class="hit-x" />
          </g>
        </g>
        <g transform="translate(301 247)">
          <g class="hit">
            <circle r="6.5" class="hit-bg" />
            <path d={cross} class="hit-x" />
          </g>
        </g>
        <text x="247.5" y="251" text-anchor="middle" class="t-small cut-label">
          {t.noInternet}
        </text>
      </g>

      <g class="dl">
        <path d={paper(166, 126, 28, 36)} class="sheet result" />
        <path d={lines(171, 140, [15, 17, 11])} class="ink" />
      </g>

      <g transform="translate(198 186)">
        <g class="click">
          <path d={cursor} class="cursor" />
        </g>
      </g>
    </g>
  )}
</svg>

<style>
  .stage {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
    font-size: 11px;
  }

  /* 무대 */
  .win {
    fill: var(--color-surface);
    stroke: var(--color-muted);
    stroke-width: 1.4;
  }
  .win-line {
    stroke: var(--color-line);
    stroke-width: 1.4;
  }
  .dot {
    fill: var(--color-line);
  }
  .ad,
  .stats {
    fill: var(--color-bg);
    stroke: var(--color-muted);
    stroke-width: 1.2;
  }
  .ad {
    stroke-dasharray: 4 3;
  }
  .tool {
    fill: var(--color-accent-soft);
    stroke: var(--color-accent);
    stroke-width: 2;
  }
  .node-box {
    fill: var(--color-surface);
    stroke: var(--color-line);
    stroke-width: 1.4;
  }
  .node.on .node-box {
    stroke: var(--color-accent);
    stroke-width: 1.8;
  }
  .node.on .node-ico {
    stroke: var(--color-accent);
  }
  .node.dim {
    opacity: 0.4;
  }
  .node-other .node-box {
    stroke-dasharray: 4 3;
  }

  /* 글자 */
  text {
    fill: var(--color-text);
  }
  .t-url {
    fill: var(--color-muted);
    font-size: 10px;
  }
  .t-tag {
    fill: var(--color-muted);
    font-size: 10px;
    font-weight: 600;
  }
  .t-muted {
    fill: var(--color-muted);
    font-size: 11px;
    font-weight: 600;
  }
  .t-frame {
    fill: var(--color-accent);
    font-size: 11px;
    font-weight: 700;
  }
  .t-node {
    font-size: 11px;
    font-weight: 700;
  }
  .t-sub,
  .t-small {
    fill: var(--color-muted);
    font-size: 10px;
  }
  .t-small {
    font-weight: 600;
  }
  .t-label {
    font-size: 10.5px;
    font-weight: 700;
  }
  .t-accent,
  .t-small.t-accent {
    fill: var(--color-accent);
  }
  .t-code {
    font-family: var(--font-mono);
    font-size: 9.6px;
  }
  .t-code .hl {
    fill: var(--color-accent);
    font-weight: 700;
  }
  .t-note {
    fill: var(--color-muted);
    font-size: 10.5px;
  }
  .t-drop {
    fill: var(--color-accent);
    font-size: 14px;
    font-weight: 700;
  }
  .t-btn {
    fill: var(--color-surface);
    font-size: 11px;
    font-weight: 700;
  }

  /* 선·아이콘 */
  .ico {
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .ico-accent {
    stroke: var(--color-accent);
  }
  .sheet {
    fill: var(--color-paper);
    stroke: var(--color-muted);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  .sheet.result {
    stroke: var(--color-accent);
    stroke-width: 1.8;
  }
  .ink {
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 1.3;
    stroke-linecap: round;
  }
  .ray {
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-dasharray: 1;
  }
  .dash {
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 1.4;
    stroke-dasharray: 3 3;
  }
  .flow,
  .flow-head {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .flow {
    stroke-dasharray: 1;
  }
  .eye-bg,
  .hit-bg {
    fill: var(--color-surface);
    stroke: var(--color-muted);
    stroke-width: 1.2;
  }
  .hit-bg {
    stroke: var(--color-accent);
    stroke-width: 1.6;
  }
  .hit-x {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .ripple {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    opacity: 0;
  }
  .worker-box {
    fill: var(--color-surface);
    stroke: var(--color-accent);
    stroke-width: 1.6;
  }
  .track {
    fill: var(--color-line);
  }
  .progress {
    fill: var(--color-accent);
  }
  /* 넓어진 도구 칸: 바깥 페이지를 덮으므로 불투명하게, 색은 도구 칸과 같은 결 */
  .overlay {
    fill: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-dasharray: 6 4;
    vector-effect: non-scaling-stroke;
    opacity: 0;
  }
  .overlay-text,
  .drag,
  .dl,
  .click,
  .feed {
    opacity: 0;
  }
  .cursor {
    fill: var(--color-text);
    stroke: var(--color-surface);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }
  .btn {
    fill: var(--color-accent);
  }
  .badge-bg {
    fill: var(--color-accent);
  }
