---
/**
 * 도구 페이지 아래 '관련 가이드'. 이 도구를 안내하는 가이드 글로 가는 링크를 단다 (없으면 그리지 않는다).
 */
import { guidesForTool, slugOf } from '../guides';
import { localeOf, localizePath } from '../i18n/locales';
import { ui } from '../i18n/ui';

interface Props {
  toolId: string;
}

const locale = localeOf(Astro.url.pathname);
const guides = guidesForTool(Astro.props.toolId, locale);
---

{guides.length > 0 && (
  <section class="guides">
    <h2>{ui(locale).guide.forTool}</h2>
    <ul>
      {guides.map((guide) => (
        <li>
          <a href={localizePath(`/guide/${slugOf(guide)}/`, locale)}>{guide.data.title}</a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .guides {
    margin-top: 48px;
  }
  h2 {
    margin: 0 0 12px;
    font-size: 22px;
  }
  ul {
    margin: 0;
    padding-left: 20px;
  }
  li {
    margin-bottom: 8px;
  }
  a {
    color: var(--color-accent);
  }
</style>
