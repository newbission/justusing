---
/**
 * CSV 한글 깨짐 고치기 도구 화면 (격리 frame 페이지 /text/csv-encoding/frame/).
 */
import FrameLayout from '../../../frame/FrameLayout.astro';
---

<FrameLayout>
  <div id="app"></div>
</FrameLayout>

<script>
  import { mount } from 'svelte';
  import App from './App.svelte';

  mount(App, { target: document.getElementById('app')! });
</script>

<style>
  #app {
    height: 100%;
  }
</style>
