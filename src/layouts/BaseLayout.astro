---
/**
 * 모든 페이지의 바깥 틀: <html>, <head>, 공통 스타일.
 */
import '../styles/global.css';
import { siteConfig } from '../site.config';
import ThemeInit from '../components/ThemeInit.astro';
import DropGuard from '../components/DropGuard.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileAnchor from '../components/MobileAnchor.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  /** 페이지 제목. 없으면 사이트명만 쓴다 (홈). */
  title?: string;
  /** 검색 결과에 나오는 설명. 없으면 사이트 설명을 쓴다. */
  description?: string;
}

const { title, description = siteConfig.description } = Astro.props;
const fullTitle = title ? `${title} - ${siteConfig.name}` : siteConfig.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={siteConfig.defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <DropGuard />
    <ThemeInit />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- 네이버 서치어드바이저 소유 확인 -->
    <meta name="naver-site-verification" content={siteConfig.verification.naver} />
    <!-- Google AdSense 소유 확인. 광고 스크립트를 불러오지 않고 태그만 둔다 -->
    <meta name="google-adsense-account" content={siteConfig.ads.adsenseClient} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Open Graph: 메신저·SNS에 링크를 붙였을 때 보이는 미리보기 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary" />
    <Analytics />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <MobileAnchor />
  </body>
</html>
