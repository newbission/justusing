---
/**
 * 도구 페이지 틀: 도구 영역 → 사용법 → FAQ → 관련 도구, 그리고 광고 슬롯 배치.
 *
 * 광고 규칙:
 * - 도구 영역(버튼 포함)과 below-tool 사이에는 로컬 처리 안내 + 버퍼 여백을 둔다.
 * - 모달·오버레이는 이 레이아웃 밖에서 열리며, 그 안에는 AdSlot을 넣지 않는다.
 */
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import RailShell from '../components/RailShell.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { siteConfig } from '../site.config';
import { localeOf } from '../i18n/locales';
import { ui } from '../i18n/ui';

interface Props {
  /** 화면 제목 (h1) */
  name: string;
  /** <title>용 제목 */
  title: string;
  description: string;
  /** 현재 위치 (홈 › 카테고리 › 도구) */
  breadcrumb: { name: string; href?: string }[];
  /** 브레드크럼에서 넘어갈 수 있는 같은 분류의 도구들 */
  siblings?: { name: string; href?: string; current?: boolean }[];
}

const { name, title, description, breadcrumb, siblings } = Astro.props;
const locale = localeOf(Astro.url.pathname);
const t = ui(locale).tool;

// 이 페이지가 무료 웹 도구임을 검색엔진에 알리는 구조화 데이터 (schema.org WebApplication)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name,
  description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: t.browserRequirements,
  inLanguage: locale,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: t.priceCurrency },
  provider: { '@type': 'Organization', name: siteConfig.name, url: Astro.site?.href },
};
---

<BaseLayout title={title} description={description}>
  <!-- 틀 안에 둔다. 틀 밖에 두면 <html>보다 먼저 출력된다 -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <RailShell>
    <article class="tool-page">
      <header class="tool-header">
        <Breadcrumb items={breadcrumb} {siblings} />
        <h1>{name}</h1>
        <p class="lead">{description}</p>
      </header>

      <!-- 제목 아래 가로 배너. 도구 칸(버튼)과 붙지 않게 아래로 32px 띄운다.
           파일을 열면 도구 칸이 화면 위쪽에 맞춰 스크롤되어 배너는 화면 밖으로 나간다. -->
      <div class="top-banner">
        <AdSlot id="top-banner" />
      </div>

      <section class="tool-area" aria-label={name}>
        <slot name="tool" />
      </section>

      <p class="local-note">{t.localNote}</p>

      <div class="below-tool">
        <AdSlot id="below-tool" />
      </div>

      <slot name="how-to" />

      <div class="in-content">
        <AdSlot id="in-content" />
      </div>

      <slot name="faq" />
      <slot name="related" />
    </article>
  </RailShell>
</BaseLayout>

<style>
  .tool-page {
    padding-top: 24px;
  }
  .tool-header h1 {
    margin: 12px 0 0;
    font-size: 28px;
    line-height: 1.3;
  }
  .lead {
    margin: 8px 0 0;
    color: var(--color-muted);
  }
  .tool-area {
    margin-top: 24px;
  }
  /* 제목 아래 가로 배너. 광고 칸이 없으면 자리도 차지하지 않는다 */
  .top-banner:not(:has(.ad-slot)) {
    display: none;
  }
  .top-banner {
    margin-top: 24px;
  }
  .top-banner:has(.ad-slot) + .tool-area {
    margin-top: 32px;
  }
  .local-note {
    margin: 16px 0 0;
    color: var(--color-muted);
    font-size: 14px;
  }

  /* 버튼과 광고 사이 버퍼: 실수 클릭 방지 */
  .below-tool {
    margin: 48px 0 32px;
  }
  .in-content {
    margin: 32px 0;
  }
</style>
