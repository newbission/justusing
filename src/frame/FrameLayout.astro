---
/**
 * 도구 화면(격리 frame) 페이지의 틀.
 *
 * 이 페이지는 도구 페이지 안의 sandbox iframe으로만 열린다. 출처가 없는(opaque) 상태라
 * 바깥 페이지의 광고·통계 스크립트가 안쪽 내용(PDF 글자, 파일 이름)을 읽을 수 없다.
 *
 * 여기에 거는 CSP는 우리 사이트 파일(라이브러리·폰트·CMap)을 읽는 것만 허용하고
 * 그 밖의 모든 외부 연결을 막는다. 도구 코드 자신도 다른 곳으로는 연결할 수 없다
 * (우리 사이트로는 연결할 수 있어, 요청에 파일이 실리지 않는지는 E2E local-only.ts가 확인한다).
 * blob URL로 띄운 워커도 이 CSP를 그대로 따른다.
 */
import '../styles/global.css';
import { localeOf, withoutLocale } from '../i18n/locales';
import { getTool } from '../tools/registry';
import { siteConfig, siteUrl } from '../site.config';

interface Props {
  /** frame 문서 제목 (스크린리더가 iframe 안에서 읽는다) */
  title: string;
}

const { title } = Astro.props;
const locale = localeOf(Astro.url.pathname);
/** 따라 하기 단계: 이 도구의 사용법 (src/frame/tour.ts). 바깥 페이지가 보낸 글은 쓰지 않으려고 빌드 때 넣는다 */
const [category, name] = withoutLocale(Astro.url.pathname).split('/').filter(Boolean);
const tourSteps = getTool(`${category}/${name}`)?.content?.[locale].howTo ?? [];

/**
 * 우리 사이트 주소. Safari(WebKit)는 출처 없는 sandbox 문서에서 'self'를 우리 사이트로 보지 않아
 * 'self'만 적으면 워커·스타일·글꼴·CMap을 받지 못한다 (크롬은 받는다). 그래서 주소를 함께 적는다.
 * www 주소로 들어와도 frame은 같은 주소에서 파일을 받으므로 둘 다 적는다.
 */
const self = `'self' ${siteUrl} https://www.${siteConfig.domain}`;

const csp = Astro.csp;
if (csp) {
  csp.insertDirective("default-src 'none'");
  csp.insertDirective(`connect-src ${self}`);
  csp.insertDirective('worker-src blob:');
  csp.insertDirective(`img-src ${self} blob: data:`);
  csp.insertDirective(`font-src ${self} data:`);
  // 동영상 도구만: 고른 동영상을 blob URL로 <video>에 연다 (파일은 이 기기 안에만 있다).
  // 다른 도구 frame은 default-src 'none' 그대로 미디어를 열지 못한다
  if (category === 'video') csp.insertDirective('media-src blob:');
  csp.insertDirective("form-action 'none'");
  csp.insertDirective("base-uri 'none'");
  // pdf.js 등이 이미지 디코딩에 WebAssembly를 쓴다 (eval 자체는 계속 금지)
  csp.insertScriptResource("'self'");
  csp.insertScriptResource(siteUrl);
  csp.insertScriptResource(`https://www.${siteConfig.domain}`);
  // 스타일 파일(/_astro/*.css)도 같은 이유로 주소를 적는다. 하나라도 넣으면 Astro의 기본값('self')이
  // 빠지고 <style> 해시도 함께 빠지므로 'self'를 먼저 직접 넣는다 (빠지면 PDF 보기 화면이 깨진다)
  csp.insertStyleResource("'self'");
  csp.insertStyleResource(siteUrl);
  csp.insertStyleResource(`https://www.${siteConfig.domain}`);
  csp.insertScriptResource("'wasm-unsafe-eval'");
} else if (!import.meta.env.DEV) {
  // 개발 서버에는 CSP 기능이 없다. 배포 빌드에서 CSP 없이 frame이 나가는 일은 막는다.
  throw new Error('도구 frame에 CSP를 걸 수 없습니다. astro.config의 security.csp를 확인하세요.');
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <!--
      테마: frame은 localStorage를 읽을 수 없으므로 바깥 페이지가 주소(#theme=dark)와
      postMessage({ type: 'theme', theme })로 알려 준다. 값이 없으면 OS 설정을 따른다.
    -->
    <script is:inline>
      (() => {
        const apply = (theme) => {
          if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
          else delete document.documentElement.dataset.theme;
        };
        apply(new URLSearchParams(location.hash.slice(1)).get('theme'));
        addEventListener('message', (event) => {
          if (event.source !== parent || event.data?.type !== 'theme') return;
          apply(event.data.theme);
        });
      })();
    </script>
  </head>
  <body data-tour={JSON.stringify(tourSteps)}>
    <!-- 파일을 끄는 동안 frame이 화면 전체로 넓어져도 이 안의 도구 화면은 원래 크기로 고정된다 -->
    <div id="frame-root">
      <slot />
    </div>
  </body>
</html>

<script>
  import { setupFrameActivity } from './activity';
  import { setupFrameDrop } from './drop';
  import { setupFrameTour } from './tour';

  setupFrameDrop();
  setupFrameActivity();
  setupFrameTour();
</script>

<style is:global>
  html,
  body,
  #frame-root {
    height: 100%;
  }

  /* 파일을 끄는 동안 frame 전체를 덮는 '여기에 놓으세요' 화면 (src/frame/drop.ts) */
  .frame-drop-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 16px;
    background: var(--color-bg);
  }
  .frame-drop-overlay[hidden] {
    display: none;
  }
  /* 따라 하기 (src/frame/tour.ts, 따라 하기 창 안의 도구 화면에서만): 아래에 단계 카드를 두고 도구 화면은 그만큼 줄인다 */
  html.touring body {
    display: flex;
    flex-direction: column;
  }
  html.touring #frame-root {
    flex: 1;
    min-height: 0;
  }
  /* 누를 곳만 밝게: 구멍 둘레의 그림자가 나머지를 어둡게 덮는다. 누르는 것은 막지 않는다 */
  .tour-spot {
    position: fixed;
    z-index: 90;
    border: 2px solid var(--color-accent);
    border-radius: var(--radius);
    box-shadow: 0 0 0 100vmax var(--color-spotlight);
    pointer-events: none;
    transition:
      left 0.15s,
      top 0.15s,
      width 0.15s,
      height 0.15s;
  }
  .tour-spot[hidden] {
    display: none;
  }
  .tour-spot-number,
  .tour-number {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-on-scrim);
    font-size: 13px;
    font-weight: 700;
  }
  /* 화면 가장자리에서도 잘리지 않게 구멍 안쪽 왼쪽 위에 둔다 */
  .tour-spot-number {
    position: absolute;
    top: -12px;
    left: 6px;
  }
  .frame-tour {
    position: relative;
    z-index: 100;
    display: grid;
    flex: none;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 8px 16px;
    padding: 14px 16px;
    border-top: 1px solid var(--color-line);
    background: var(--color-surface);
    font-size: 15px;
  }
  .frame-tour[hidden] {
    display: none;
  }
  .tour-head {
    display: flex;
    grid-column: 1 / -1;
    align-items: center;
    gap: 8px;
  }
  .tour-count {
    color: var(--color-muted);
    font-size: 13px;
  }
  .frame-tour p {
    margin: 0;
    line-height: 1.55;
  }
  .tour-actions {
    display: flex;
    gap: 6px;
  }
  .frame-tour button {
    height: 36px;
    padding: 0 14px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: transparent;
    font-size: 14px;
    white-space: nowrap;
    cursor: pointer;
  }
  .frame-tour button[hidden] {
    display: none;
  }
  .frame-tour button:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .frame-tour button.primary {
    border-color: var(--color-text);
    background: var(--color-text);
    color: var(--color-bg);
    font-weight: 600;
  }
  /* 좁은 화면: 단계 글 아래에 버튼 줄 */
  @media (max-width: 560px) {
    .frame-tour {
      grid-template-columns: 1fr;
    }
    .tour-actions button {
      flex: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tour-spot {
      transition: none;
    }
  }

  /* 끌기 신호가 덮개에만 가도록 안쪽 글자는 대상에서 뺀다 (덮개를 떠날 때만 dragleave) */
  .frame-drop-overlay * {
    pointer-events: none;
  }
  .frame-drop-overlay p {
    display: grid;
    place-items: center;
    gap: 8px;
    width: 100%;
    height: 100%;
    margin: 0;
    border: 3px dashed var(--color-accent);
    border-radius: var(--radius);
    text-align: center;
  }
  .frame-drop-overlay strong {
    align-self: end;
    font-size: 22px;
  }
  .frame-drop-overlay span {
    align-self: start;
    color: var(--color-muted);
  }
</style>
