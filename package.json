{
  "name": "justusing",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev --port 4322",
    "astro": "astro",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "predev": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-font-license.mjs && node scripts/copy-libheif-notice.mjs && node scripts/copy-mediabunny-notice.mjs && node scripts/copy-ocr-data.mjs && node scripts/copy-face-data.mjs",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-font-license.mjs && node scripts/copy-libheif-notice.mjs && node scripts/copy-mediabunny-notice.mjs && node scripts/copy-ocr-data.mjs && node scripts/copy-face-data.mjs",
    "test:e2e": "playwright test",
    "build:ad-preview": "SHOW_AD_PLACEHOLDERS=1 npm run build"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.0.1",
    "@cantoo/fontkit": "^2.0.12",
    "@cantoo/pdf-lib": "^2.11.1",
    "@mediapipe/tasks-vision": "1.1.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "astro": "^7.3.8",
    "fflate": "^0.8.3",
    "gifenc": "1.0.3",
    "libheif-js": "1.23.5",
    "mediabunny": "1.61.6",
    "pdfjs-dist": "^6.4.299",
    "pretendard": "1.3.9",
    "svelte": "^5.57.2",
    "tesseract.js-core": "6.1.2",
    "typescript": "^6.0.3",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/upng-js": "^2.1.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "wrangler": "^4.149.0"
  }
}
